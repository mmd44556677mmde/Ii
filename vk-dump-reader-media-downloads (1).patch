+ *
+ *  * a local path opens immediately — the dump's own files need nobody's permission;
+ *  * a cached remote artifact opens immediately;
+ *  * a running one does nothing (a second tap joins the first download, never duplicates it);
+ *  * an idle one starts downloading and stays on the page — the progress ring is the feedback;
+ *  * under the Ask policy the request parks in [pendingConfirmation] until the app-level dialog
+ *    answers it, so the user is asked once, not per tile.
+ *
+ * The controller knows nothing about Compose: the designsystem talks to it through a thin adapter
+ * wired up in the app module.
+ */
+@Singleton
+class MediaAccessController @Inject constructor(
+    private val repository: MediaDownloadRepository,
+    private val settingsRepository: SettingsRepository,
+    private val janitor: MediaCacheJanitor,
+    @ApplicationContext context: Context,
+) {
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val connectivity = context.getSystemService(ConnectivityManager::class.java)
+
+    /** The request waiting for the user's yes/no under the Ask policy, if any. */
+    private val _pendingConfirmation = MutableStateFlow<DownloadRequest?>(null)
+    val pendingConfirmation: StateFlow<DownloadRequest?> = _pendingConfirmation.asStateFlow()
+
+    /**
+     * The stable key one media artifact is tracked by: `sha256(profileId|type|path)`. Stable
+     * across restarts and re-imports, so a grid tile, its viewer page and the Storage Usage list
+     * all land on the same row without passing ids around.
+     *
+     * Null when the attachment can never have a full-quality copy worth tracking (blank path).
+     */
+    fun mediaKeyOf(profileId: String, type: AttachmentType, path: String): String? {
+        if (path.isBlank()) return null
+        return MediaKeys.of(profileId, type.name.lowercase(Locale.ROOT), path)
+    }
+
+    /** True when [path] is a file inside the dump rather than a CDN link. */
+    fun isLocalPath(path: String): Boolean = !path.startsWith("http")
+
+    /**
+     * The overlay state for the tile (or viewer page) behind [mediaKey]: the download row's state
+     * folded together with the current policy, so an idle row under Wi-Fi-only on metered data
+     * reports Blocked instead of looking like nothing is happening.
+     */
+    fun observeTileState(mediaKey: String): Flow<TileMediaState> =
+        combine(
+            repository.observeState(mediaKey),
+            settingsRepository.settings.map { it.remoteMediaPolicy }.distinctUntilChanged(),
+        ) { state, policy ->
+            foldToTileState(state, policy)
+        }
+
+    /**
