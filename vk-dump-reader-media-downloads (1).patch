@@ -0,0 +1,235 @@
+package com.etozhesandy.redpanda.core.mediadownload.data.downloader
+
+import com.etozhesandy.redpanda.core.common.dispatcher.IoDispatcher
+import com.etozhesandy.redpanda.core.mediadownload.di.MediaDownloadOkHttp
+import com.etozhesandy.redpanda.core.storage.db.mediadownload.MediaDownloadDao
+import com.etozhesandy.redpanda.core.storage.db.mediadownload.MediaDownloadEntity
+import java.io.File
+import java.io.IOException
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.job
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.withContext
+import okhttp3.Call
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.Response
+import okio.buffer
+import okio.sink
+import okio.source
+
+/**
+ * The chunked, offset-persisting transfer engine behind resumable downloads. One method:
+ * [runTransfer] copies bytes from a source (HTTP or a dump-local file) into the destination until
+ * complete, persisting every chunk to Room — cancellation at any point leaves the row at the last
+ * written offset, which the next run continues from.
+ *
+ * HTTP resume protocol:
+ *  - sends `Range: bytes=<offset>-` plus `If-Range: <etag>` when an etag is on file;
+ *  - a `206 Partial Content` answer appends from the offset;
+ *  - a `200 OK` answer means the resource changed (or the server ignores ranges): the transfer
+ *    restarts from zero, because continuing would splice two files together;
+ *  - every answer's validators are recorded, so the next resume re-checks against the same
+ *    resource rather than blindly appending.
+ *
+ * Cancellation note: a blocked socket read cannot be interrupted by the coroutine machinery —
+ * the cancellation handler installed in [transferRemote] closes the call the moment the job ends,
+ * so a pause lands within one chunk instead of hanging until the CDN times out. Every line runs
+ * on [IoDispatcher]; the caller owns scheduling, and the only cancellation-safe guarantee it
+ * needs is the one [runTransfer] makes: offsets on disk are always the bytes actually written.
+ */
+@Singleton
+class ChunkedTransfer @Inject constructor(
+    @MediaDownloadOkHttp private val client: OkHttpClient,
+    private val dao: MediaDownloadDao,
+    @IoDispatcher private val ioDispatcher: CoroutineDispatcher,
+) {
+
+    /** A screen of tiles can ask at once; a few transfers at a time keep the first from starving. */
+    private val slots = Semaphore(MAX_CONCURRENT_TRANSFERS)
+
+    /**
+     * Copies [entity]'s source into [entity.destPath], updating the row as it goes. Suspends until
+     * the transfer completes or the caller's scope cancels it (a pause, or the screen going away);
+     * never throws for an ordinary network failure — that lands in the row as FAILED.
+     */
+    suspend fun runTransfer(entity: MediaDownloadEntity) = slots.withPermit {
+        withContext(ioDispatcher) {
+            try {
+                if (entity.remoteUrl != null) {
+                    transferRemote(entity)
+                } else {
+                    transferLocal(entity)
+                }
+                dao.updateStatus(
+                    entity.mediaKey,
+                    MediaDownloadEntity.STATUS_COMPLETED,
+                    null,
+                    System.currentTimeMillis(),
+                )
+            } catch (e: IOException) {
+                // Cancellation on Android surfaces as an IOException raised by the interrupted
+                // socket; an actual pause must not be recorded as a failure, so ensureActive
+                // re-raises the real cancellation here instead.
+                currentCoroutineContext().ensureActive()
+                dao.updateStatus(
+                    entity.mediaKey,
+                    MediaDownloadEntity.STATUS_FAILED,
+                    e.message?.take(200),
+                    System.currentTimeMillis(),
+                )
+            }
+        }
+    }
+
+    private suspend fun transferRemote(entity: MediaDownloadEntity) {
+        val dest = File(entity.destPath)
+        val call = buildCall(entity, dest.length().coerceAtLeast(0L))
+        // Fires on cancellation AND on normal completion; on the former it is what unblocks the
+        // socket, on the latter cancelling a finished call is a no-op. Disposed on every exit.
+        val cancellation = currentCoroutineContext().job.invokeOnCompletion { call.cancel() }
+        try {
+            call.execute().use { resp ->
+                route(entity, dest, resp)
+            }
+        } finally {
+            cancellation.dispose()
+            call.cancel()
+        }
+    }
+
+    private fun buildCall(entity: MediaDownloadEntity, offset: Long): Call {
+        val builder = Request.Builder()
+            .url(entity.remoteUrl!!)
+            // Ranges mean nothing over a re-encoded stream; identity keeps offsets byte-exact.
+            .header("Accept-Encoding", "identity")
+        if (offset > 0) {
+            builder.header("Range", "bytes=$offset-")
+            entity.etag?.let { builder.header("If-Range", it) }
+        }
+        return client.newCall(builder.build())
+    }
+
+    private suspend fun route(entity: MediaDownloadEntity, dest: File, resp: Response) {
+        if (!resp.isSuccessful) throw IOException("HTTP ${resp.code}")
+        when {
+            resp.code == HTTP_OK && dest.length() > 0 -> {
+                // A 200 to a ranged request: the resource changed, the offset is meaningless.
+                dest.delete()
+                recordValidators(entity, resp, bodyLengthOf(resp))
+                copyInto(entity, dest, resp, startBytes = 0L, totalBytes = bodyLengthOf(resp))
+            }
+
+            resp.code == HTTP_PARTIAL -> {
+                val offset = dest.length().coerceAtLeast(0L)
+                recordValidators(entity, resp, rangeTotalOf(resp, offset))
+                copyInto(entity, dest, resp, startBytes = offset, totalBytes = rangeTotalOf(resp, offset))
+            }
+
+            else -> {
+                recordValidators(entity, resp, bodyLengthOf(resp))
+                copyInto(entity, dest, resp, startBytes = 0L, totalBytes = bodyLengthOf(resp))
+            }
+        }
+    }
+
+    private suspend fun transferLocal(entity: MediaDownloadEntity) {
+        val sourceFile = File(entity.localSourcePath ?: throw IOException("missing local source path"))
+        if (!sourceFile.exists()) throw IOException("dump file missing: ${sourceFile.name}")
+        val dest = File(entity.destPath)
+        dest.parentFile?.mkdirs()
+        val offset = dest.length().coerceAtLeast(0L)
+        if (offset >= sourceFile.length()) return // already fully copied
+        // A dump-local copy knows its total up front and needs no validators; the row tracks the
+        // same byte offset semantics as a remote fetch, so resume is identical from here on.
+        dest.sink(append = true).buffer().use { sink ->
+            sourceFile.source().buffer().use { reader ->
+                reader.skip(offset)
+                copyLoop(entity, sink, reader, startBytes = offset, totalBytes = sourceFile.length())
+            }
+        }
+    }
+
+    private suspend fun copyInto(
+        entity: MediaDownloadEntity,
+        dest: File,
+        resp: Response,
+        startBytes: Long,
+        totalBytes: Long,
+    ) {
+        val body = resp.body ?: throw IOException("empty body")
+        dest.parentFile?.mkdirs()
+        dest.sink(append = startBytes > 0).buffer().use { sink ->
+            body.source().use { reader ->
+                copyLoop(entity, sink, reader, startBytes, totalBytes)
+            }
+        }
+    }
+
+    /**
+     * The loop itself: read a chunk, write it, persist the offset. Persisting per chunk is what
+     * makes a `kill -9` survivable at the cost of one indexed UPDATE per [CHUNK_BYTES] — noise
+     * even on a slow disk, and the price of never re-downloading from zero.
+     */
+    private suspend fun copyLoop(
+        entity: MediaDownloadEntity,
+        sink: okio.BufferedSink,
+        reader: okio.BufferedSource,
+        startBytes: Long,
+        totalBytes: Long,
+    ) {
+        var written = startBytes
+        // [totalBytes] is the artifact's full size (Content-Range's total, or the dump file's
+        // length) — already including the offset, never added on top.
+        val knownTotal = if (totalBytes > 0) totalBytes else MediaDownloadEntity.SIZE_UNKNOWN
+        val buffer = ByteArray(CHUNK_BYTES)
+        while (true) {
+            currentCoroutineContext().ensureActive()
+            val read = reader.read(buffer, 0, buffer.size)
+            if (read == -1) break
+            sink.write(buffer, 0, read)
+            sink.flush()
+            written += read
+            dao.updateProgress(
+                mediaKey = entity.mediaKey,
+                status = MediaDownloadEntity.STATUS_DOWNLOADING,
+                downloadedBytes = written,
+                totalBytes = knownTotal,
+                updatedAt = System.currentTimeMillis(),
+            )
+        }
+    }
+
+    private suspend fun recordValidators(entity: MediaDownloadEntity, resp: Response, total: Long) {
+        dao.updateValidators(
+            mediaKey = entity.mediaKey,
+            etag = resp.header("ETag"),
+            lastModified = resp.header("Last-Modified"),
+            acceptRanges = resp.header("Accept-Ranges")?.equals("bytes", ignoreCase = true) == true,
+            totalBytes = total,
+        )
+    }
+
+    /** Total size the progress ring divides by: Content-Range's total, else Content-Length + offset. */
+    private fun rangeTotalOf(resp: Response, offset: Long): Long {
+        val total = resp.header("Content-Range")
+            ?.substringAfterLast('/')
+            ?.toLongOrNull()
+            ?.takeIf { it > 0 }
+        return total ?: (offset + bodyLengthOf(resp))
+    }
+
+    private fun bodyLengthOf(resp: Response): Long = resp.body?.contentLength() ?: MediaDownloadEntity.SIZE_UNKNOWN
+
+    private companion object {
+        const val HTTP_OK = 200
+        const val HTTP_PARTIAL = 206
+        const val CHUNK_BYTES = 256 * 1024
+        const val MAX_CONCURRENT_TRANSFERS = 3
+    }
+}
