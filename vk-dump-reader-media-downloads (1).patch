+     * viewer page switches from the streaming preview to the local file the moment it completes.
+     */
+    fun observeResolvedFile(mediaKey: String): Flow<String?> =
+        repository.observeState(mediaKey).map { state -> (state as? MediaDownloadState.Completed)?.file }
+
+    /** True when remote images may be displayed at all under the current policy and network. */
+    fun observeRemoteDisplayAllowed(): Flow<Boolean> =
+        settingsRepository.settings
+            .map { it.remoteMediaPolicy }
+            .distinctUntilChanged()
+            .map { policy -> policy == RemoteMediaPolicy.ASK || policy == RemoteMediaPolicy.ALWAYS || (policy == RemoteMediaPolicy.WIFI_ONLY && !isMetered()) }
+
+    /**
+     * The tap on a media tile. [open] is invoked on the main thread exactly when the viewer may
+     * open — locally available media, or a fully cached artifact.
+     */
+    fun onTileTap(attachment: Attachment, open: () -> Unit) {
+        scope.launch {
+            val opened = handleTap(attachment)
+            if (opened) withContext(Dispatchers.Main.immediate) { open() }
+        }
+    }
+
+    /**
+     * A viewer page became visible: the user is looking at the media on purpose, so the
+     * full-quality fetch starts without a tap (still policy-gated).
+     */
+    fun onViewerPageOpen(attachment: Attachment) {
+        scope.launch { startOrPark(attachment) }
+    }
+
+    /** Accepts the parked Ask-policy request and starts the download. */
+    fun acceptPendingConfirmation() {
+        val request = _pendingConfirmation.value ?: return
+        _pendingConfirmation.value = null
+        scope.launch { requestAndSweep(request) }
+    }
+
+    /** Dismisses the parked Ask-policy request; the tile goes back to idle. */
+    fun denyPendingConfirmation() {
+        _pendingConfirmation.value = null
+    }
+
+    // --- video -------------------------------------------------------------------------------
+
+    /**
+     * The tap on a video tile: unlike a photo, playback starts immediately — the player shows
+     * its buffering while the fetch fills the file behind it, and the download runs for exactly
+     * as long as the player page lives. [open] is invoked on the main thread right away.
+     */
+    fun onVideoTileTap(attachment: Attachment, open: () -> Unit) {
+        scope.launch {
+            val key = mediaKeyOf(attachment.profileId, attachment.type, attachment.path)
+            if (isLocalPath(attachment.path) || key == null) {
+                withContext(Dispatchers.Main.immediate) { open() }
+                return@launch
+            }
+            // A Completed copy is re-played as-is; anything else (re)starts the fetch, policy
+            // permitting, and opens the player over the growing file.
+            when (repository.currentState(key)) {
+                is MediaDownloadState.Completed -> Unit
+                else -> startOrPark(attachment)
+            }
+            withContext(Dispatchers.Main.immediate) { open() }
+        }
+    }
+
+    /** The player page went away: nothing else may keep the fetch running, so pause it. */
+    fun onVideoPageClosed(mediaKey: String) {
+        scope.launch { repository.pause(mediaKey) }
+    }
+
+    /** The in-player pause control: stops at the current offset, bytes kept. */
+    fun pauseDownload(mediaKey: String) {
+        scope.launch { repository.pause(mediaKey) }
+    }
+
+    /** The in-player resume control: continues from the persisted offset. */
+    fun resumeDownload(mediaKey: String) {
+        scope.launch { repository.resume(mediaKey) }
+    }
+
+    /**
+     * A `DataSource.Factory` that plays the file behind [mediaKey] while it is still being
+     * appended to, or null when the key is unknown (the player then falls back to its default
+     * source). The liveness answer is read on the loader thread only when the file's bytes run
+     * out, so the row is queried rarely and never on the main thread.
+     */
+    fun videoSourceFactory(mediaKey: String?): DataSource.Factory? {
+        if (mediaKey == null) return null
+        return DataSource.Factory {
+            GrowingFileDataSource(
+                fileProvider = { runBlocking { repository.partialFile(mediaKey) } },
+                liveness = { runBlocking { livenessOf(mediaKey) } },
+            )
+        }
+    }
+
+    private suspend fun livenessOf(mediaKey: String): DownloadLiveness =
+        when (val state = repository.currentState(mediaKey)) {
+            is MediaDownloadState.Completed -> DownloadLiveness.COMPLETE
+            is MediaDownloadState.Running, is MediaDownloadState.Queued -> DownloadLiveness.GROWING
+            else -> DownloadLiveness.STALLED
+        }
+
+    // --- internals ---------------------------------------------------------------------------
+
+    /** Returns true when the tap should end in the viewer opening. */
+    private suspend fun handleTap(attachment: Attachment): Boolean {
+        val key = mediaKeyOf(attachment.profileId, attachment.type, attachment.path)
+            ?: return true // nothing trackable (blank path): let the viewer show its placeholder
+        if (isLocalPath(attachment.path)) return true
+        return when (repository.currentState(key)) {
+            is MediaDownloadState.Completed -> true
+            is MediaDownloadState.Queued, is MediaDownloadState.Running -> false
+            else -> {
+                startOrPark(attachment)
+                false
+            }
+        }
+    }
+
+    private suspend fun startOrPark(attachment: Attachment) {
+        val key = mediaKeyOf(attachment.profileId, attachment.type, attachment.path) ?: return
+        if (isLocalPath(attachment.path)) return
+        when (evaluatePolicy()) {
+            PolicyDecision.ALLOWED -> requestAndSweep(buildRequest(attachment, key))
+            PolicyDecision.NEEDS_CONFIRMATION -> _pendingConfirmation.value = buildRequest(attachment, key)
+            PolicyDecision.BLOCKED -> Unit // the tile overlays the reason; nothing to start
+        }
+    }
+
+    /** A finished fetch re-locks the cache against the user's limits; a failed one costs nothing. */
+    private suspend fun requestAndSweep(request: DownloadRequest) {
+        val state = repository.request(request)
+        if (state is MediaDownloadState.Completed) janitor.sweep()
+    }
+
+    private suspend fun evaluatePolicy(): PolicyDecision {
+        val policy = settingsRepository.settings.first().remoteMediaPolicy
+        return when (policy) {
+            RemoteMediaPolicy.ALWAYS -> PolicyDecision.ALLOWED
+            RemoteMediaPolicy.NEVER -> PolicyDecision.BLOCKED
+            RemoteMediaPolicy.WIFI_ONLY -> if (isMetered()) PolicyDecision.BLOCKED else PolicyDecision.ALLOWED
+            RemoteMediaPolicy.ASK -> PolicyDecision.NEEDS_CONFIRMATION
+        }
+    }
+
+    private fun isMetered(): Boolean = connectivity?.isActiveNetworkMetered ?: true
+
+    private fun foldToTileState(state: MediaDownloadState, policy: RemoteMediaPolicy): TileMediaState =
+        when (state) {
+            MediaDownloadState.Idle -> when (policy) {
+                RemoteMediaPolicy.NEVER -> TileMediaState.Blocked(TileBlockReason.NEVER)
+                RemoteMediaPolicy.WIFI_ONLY ->
+                    if (isMetered()) TileMediaState.Blocked(TileBlockReason.METERED) else TileMediaState.Hidden
+                else -> TileMediaState.Hidden
+            }
+            is MediaDownloadState.Queued -> TileMediaState.Queued
+            is MediaDownloadState.Running -> TileMediaState.Downloading(state.fraction)
+            is MediaDownloadState.Paused -> TileMediaState.Paused
+            is MediaDownloadState.Failed -> TileMediaState.Hidden // tap retries; no permanent scar on the tile
+            is MediaDownloadState.Blocked -> TileMediaState.Blocked(
+                if (state.reason.contains("metered", ignoreCase = true)) TileBlockReason.METERED else TileBlockReason.NEVER,
+            )
+            is MediaDownloadState.Completed -> TileMediaState.Completed
+        }
+
+    private fun buildRequest(attachment: Attachment, mediaKey: String): DownloadRequest = DownloadRequest(
+        mediaKey = mediaKey,
+        profileId = attachment.profileId,
+        // Blank dialog ids mean the attachment hangs off a profile surface (saved photos, media
+        // galleries): the row then groups under the profile on the Storage Usage screen.
+        dialogId = attachment.dialogId.takeIf { it.isNotBlank() },
+        attachmentId = attachment.id,
+        ownerType = if (attachment.dialogId.isNotBlank()) MediaOwnerType.DIALOG else MediaOwnerType.PROFILE,
+        category = MediaCategory.from(attachment.type),
+        remoteUrl = attachment.path,
+        localSourcePath = null,
+        extension = attachment.path
+            .substringBefore('?')
+            .substringAfterLast('/')
+            .substringAfterLast('.', missingDelimiterValue = "")
+            .take(8)
+            .lowercase(Locale.ROOT),
+    )
+
+    private enum class PolicyDecision { ALLOWED, NEEDS_CONFIRMATION, BLOCKED }
+}
