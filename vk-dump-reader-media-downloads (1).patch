@@ -0,0 +1,58 @@
+package com.etozhesandy.redpanda.core.storage.db.migration
+
+import androidx.room.migration.Migration
+import androidx.sqlite.SQLiteConnection
+import androidx.sqlite.execSQL
+
+/**
+ * Adds the resumable media-download table. Purely additive: no existing table is touched, so
+ * profiles imported on any earlier schema keep every row. Cache state starts empty — nothing is
+ * downloaded until the user taps media, and the Storage Usage screen reports zeros until then.
+ */
+internal val MIGRATION_7_8: Migration = object : Migration(7, 8) {
+    override fun migrate(connection: SQLiteConnection) {
+        connection.execSQL(
+            """
+            CREATE TABLE IF NOT EXISTS `media_downloads` (
+                `mediaKey` TEXT NOT NULL,
+                `attachmentId` TEXT,
+                `profileId` TEXT NOT NULL,
+                `dialogId` TEXT,
+                `ownerId` TEXT NOT NULL,
+                `ownerType` TEXT NOT NULL,
+                `category` TEXT NOT NULL,
+                `remoteUrl` TEXT,
+                `localSourcePath` TEXT,
+                `destPath` TEXT NOT NULL,
+                `status` TEXT NOT NULL,
+                `downloadedBytes` INTEGER NOT NULL,
+                `totalBytes` INTEGER NOT NULL,
+                `etag` TEXT,
+                `lastModified` TEXT,
+                `acceptRanges` INTEGER NOT NULL,
+                `failReason` TEXT,
+                `createdAt` INTEGER NOT NULL,
+                `updatedAt` INTEGER NOT NULL,
+                `lastAccessedAt` INTEGER NOT NULL,
+                PRIMARY KEY(`mediaKey`)
+            )
+            """.trimIndent(),
+        )
+        connection.execSQL(
+            "CREATE INDEX IF NOT EXISTS `index_media_downloads_ownerType_ownerId` " +
+                "ON `media_downloads` (`ownerType`, `ownerId`)",
+        )
+        connection.execSQL(
+            "CREATE INDEX IF NOT EXISTS `index_media_downloads_category` " +
+                "ON `media_downloads` (`category`)",
+        )
+        connection.execSQL(
+            "CREATE INDEX IF NOT EXISTS `index_media_downloads_status` " +
+                "ON `media_downloads` (`status`)",
+        )
+        connection.execSQL(
+            "CREATE INDEX IF NOT EXISTS `index_media_downloads_lastAccessedAt` " +
+                "ON `media_downloads` (`lastAccessedAt`)",
+        )
+    }
+}
