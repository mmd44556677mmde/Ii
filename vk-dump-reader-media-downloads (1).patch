+package com.etozhesandy.redpanda.core.mediadownload.di
+
+import com.etozhesandy.redpanda.core.mediadownload.net.MediaHostAllowlist
+import dagger.Module
+import dagger.Provides
+import dagger.hilt.InstallIn
+import dagger.hilt.components.SingletonComponent
+import java.util.concurrent.TimeUnit
+import javax.inject.Singleton
+import okhttp3.OkHttpClient
+
+@Module
+@InstallIn(SingletonComponent::class)
+object MediaDownloadModule {
+
+    /**
+     * The media client is built separately from anything else on purpose:
+     *  - the allowlist interceptor is the privacy wall (see [MediaHostAllowlist]);
+     *  - no cookie jar, no logging of URLs, and no HTTP cache here — full media has its own file
+     *    cache tracked in Room, and thumbnails ride Coil's;
+     *  - connect/read timeouts are generous because a VK CDN link can be slow without being dead.
+     */
+    @Provides
+    @Singleton
+    @MediaDownloadOkHttp
+    fun provideMediaOkHttp(): OkHttpClient =
+        OkHttpClient.Builder()
+            .addInterceptor(MediaHostAllowlist.default().interceptor())
+            .connectTimeout(30, TimeUnit.SECONDS)
+            .readTimeout(60, TimeUnit.SECONDS)
+            .build()
+}
