@@ -0,0 +1,296 @@
+package com.etozhesandy.redpanda.core.mediadownload.data
+
+import android.content.Context
+import com.etozhesandy.redpanda.core.common.dispatcher.IoDispatcher
+import com.etozhesandy.redpanda.core.mediadownload.data.downloader.ChunkedTransfer
+import com.etozhesandy.redpanda.core.mediadownload.data.downloader.MediaFiles
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.CachedMedia
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.DownloadRequest
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.MediaCategory
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.MediaDownloadState
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.MediaOwnerType
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.MediaUsage
+import com.etozhesandy.redpanda.core.mediadownload.domain.repository.MediaDownloadRepository
+import com.etozhesandy.redpanda.core.storage.db.mediadownload.MediaDownloadDao
+import com.etozhesandy.redpanda.core.storage.db.mediadownload.MediaDownloadEntity
+import com.etozhesandy.redpanda.core.storage.db.mediadownload.MediaUsageSummary
+import dagger.hilt.android.qualifiers.ApplicationContext
+import java.io.File
+import java.io.RandomAccessFile
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/**
+ * The repository facade over [ChunkedTransfer] and the Room table. Owns three things the raw
+ * transfer engine must not know about:
+ *
+ *  1. which transfers are currently alive, so a second tap joins the first instead of racing it;
+ *  2. the cache-hit path — a Completed row answers with the file and bumps the LRU clock;
+ *  3. recovery — at process start, rows left DOWNLOADING/QUEUED by a dead process become PAUSED
+ *     with their offsets intact.
+ *
+ * Transfers run on this singleton's own scope and die the moment a screen calls [pause] or its
+ * caller goes away. Nothing keeps downloading behind the user's back; only the persisted offsets
+ * survive the process.
+ */
+@Singleton
+class MediaDownloadRepositoryImpl @Inject constructor(
+    @ApplicationContext private val context: Context,
+    private val dao: MediaDownloadDao,
+    private val transfer: ChunkedTransfer,
+    @IoDispatcher private val ioDispatcher: CoroutineDispatcher,
+) : MediaDownloadRepository {
+
+    private val scope = CoroutineScope(SupervisorJob() + ioDispatcher)
+
+    /** Guards [running] and the start/stop transitions, so two taps cannot race on one key. */
+    private val mutex = Mutex()
+
+    /** mediaKey → the job moving bytes for it right now; guarded by [mutex]. */
+    private val running = HashMap<String, Job>()
+
+    private val cacheDir: File
+        get() = File(context.cacheDir, MediaFiles.CACHE_DIR_NAME).apply { mkdirs() }
+
+    override suspend fun recoverInterruptedDownloads() {
+        dao.demoteRunningToPaused(System.currentTimeMillis())
+    }
+
+    override fun observeState(mediaKey: String): Flow<MediaDownloadState> =
+        dao.observe(mediaKey).map { it?.toDomain() ?: MediaDownloadState.Idle }
+
+    override suspend fun currentState(mediaKey: String): MediaDownloadState =
+        dao.get(mediaKey)?.toDomain() ?: MediaDownloadState.Idle
+
+    override suspend fun request(request: DownloadRequest): MediaDownloadState = mutex.withLock {
+        val now = System.currentTimeMillis()
+        val existing = dao.get(request.mediaKey)
+        if (existing?.status == MediaDownloadEntity.STATUS_COMPLETED) {
+            dao.touch(request.mediaKey, now)
+            return existing.toDomain()
+        }
+        dao.upsert(
+            existing?.copy(
+                status = MediaDownloadEntity.STATUS_QUEUED,
+                failReason = null,
+                updatedAt = now,
+            ) ?: request.toEntity(cacheDir, now),
+        )
+        startLocked(request.mediaKey)
+        currentState(request.mediaKey)
+    }
+
+    override suspend fun pause(mediaKey: String) {
+        val job = mutex.withLock { running.remove(mediaKey) } ?: return
+        job.cancel()
+        job.join() // the transfer's cancellation handler closed the socket; the file is at rest
+        val entity = dao.get(mediaKey) ?: return
+        // The last chunk may have been flushed after the final row update; the file length is the
+        // truth, so the pause records exactly the bytes on disk and none of them are thrown away.
+        val bytes = File(entity.destPath).takeIf { it.exists() }?.length() ?: entity.downloadedBytes
+        dao.updateProgress(
+            mediaKey = mediaKey,
+            status = MediaDownloadEntity.STATUS_PAUSED,
+            downloadedBytes = bytes,
+            totalBytes = entity.totalBytes,
+            updatedAt = System.currentTimeMillis(),
+        )
+    }
+
+    override suspend fun resume(mediaKey: String) {
+        mutex.withLock {
+            val entity = dao.get(mediaKey) ?: return
+            if (entity.status == MediaDownloadEntity.STATUS_COMPLETED) return
+            // A torn tail write (power loss mid-chunk) can leave the file longer than the row
+            // knows; cut it back so "bytes on disk" and "bytes in the row" agree before appending.
+            File(entity.destPath).takeIf { it.length() > entity.downloadedBytes }?.let { file ->
+                RandomAccessFile(file, "rw").use { raf -> raf.setLength(entity.downloadedBytes) }
+            }
+            dao.updateStatus(mediaKey, MediaDownloadEntity.STATUS_QUEUED, null, System.currentTimeMillis())
+            startLocked(mediaKey)
+        }
+    }
+
+    override suspend fun cancel(mediaKey: String) {
+        val job = mutex.withLock { running.remove(mediaKey) }
+        job?.cancel()
+        job?.join()
+        dao.get(mediaKey)?.let { File(it.destPath).delete() }
+        dao.deleteByKeys(listOf(mediaKey))
+    }
+
+    override suspend fun cachedFile(mediaKey: String): File? {
+        val entity = dao.get(mediaKey) ?: return null
+        if (entity.status != MediaDownloadEntity.STATUS_COMPLETED) return null
+        dao.touch(mediaKey, System.currentTimeMillis())
+        return File(entity.destPath).takeIf { it.exists() }
+    }
+
+    override suspend fun partialFile(mediaKey: String): File? {
+        val entity = dao.get(mediaKey) ?: return null
+        return File(entity.destPath).takeIf { it.exists() }
+    }
+
+    override suspend fun peekCached(mediaKey: String): CachedMedia? {
+        val entity = dao.get(mediaKey) ?: return null
+        if (entity.status != MediaDownloadEntity.STATUS_COMPLETED) return null
+        val file = File(entity.destPath).takeIf { it.exists() } ?: return null
+        dao.touch(mediaKey, System.currentTimeMillis())
+        return CachedMedia(file, entity.downloadedBytes)
+    }
+
+    // --- Storage Usage ----------------------------------------------------------------------
+
+    override fun observeUsageByCategory(): Flow<List<MediaUsage>> =
+        dao.observeUsageByCategory().map { rows -> rows.map { row -> row.toDomain() } }
+
+    override fun observeUsageByOwner(): Flow<List<MediaUsage>> =
+        dao.observeUsageByOwner().map { rows -> rows.map { row -> row.toDomain() } }
+
+    override fun observeUsageByOwnerNamed(): Flow<List<MediaUsage>> =
+        dao.observeUsageByOwnerNamed().map { rows -> rows.map { row -> row.toDomain() } }
+
+    override fun observeTotalCachedBytes(): Flow<Long> =
+        dao.observeCompletedBytes().map { it ?: 0L }
+
+    override suspend fun purgeCategories(categories: Set<String>): Long {
+        val columnNames = categories.map { category -> MediaCategory.valueOf(category).toColumn() }
+        val targets = columnNames.flatMap { column -> dao.completedByCategory(column) }
+        return purge(targets)
+    }
+
+    override suspend fun purgeOwner(ownerType: String, ownerId: String): Long =
+        purge(dao.completedByOwner(ownerType, ownerId))
+
+    override suspend fun purgeNotAccessedSinceDays(retentionDays: Int): Long {
+        val threshold = System.currentTimeMillis() - retentionDays * DAY_MS
+        return purge(dao.completedNotAccessedSince(threshold))
+    }
+
+    override suspend fun purgeNotAccessedSinceByCategory(category: String, retentionDays: Int): Long {
+        val threshold = System.currentTimeMillis() - retentionDays * DAY_MS
+        // The stored category text equals the enum name on purpose, so the setting's string key
+        // matches the column without another mapping table.
+        return purge(dao.completedNotAccessedSince(threshold).filter { it.category == category })
+    }
+
+    override suspend fun evictToLimit(limitBytes: Long): Long {
+        var freed = 0L
+        while ((dao.completedBytesSum() ?: 0L) > limitBytes) {
+            // Evicting one at a time re-reads the sum, but the oldest entries are usually a
+            // handful of rows and correctness beats a cleverer loop here: never evict past the
+            // limit, and stop when the table has nothing completed left to give.
+            val oldest = dao.oldestCompleted(EVICT_BATCH)
+            if (oldest.isEmpty()) break
+            freed += purge(oldest.take(1))
+        }
+        return freed
+    }
+
+    override fun cacheDirectory(): File = cacheDir
+
+    // --- internals --------------------------------------------------------------------------
+
+    /** Callers must hold [mutex]: a second start on a live job would open a second socket. */
+    private fun startLocked(mediaKey: String) {
+        if (running[mediaKey]?.isActive == true) return
+        val job = scope.launch {
+            val entity = dao.get(mediaKey) ?: return@launch
+            transfer.runTransfer(entity)
+        }
+        running[mediaKey] = job
+        job.invokeOnCompletion { _ -> running.remove(mediaKey) }
+    }
+
+    /** Deletes the files, then the rows; the file delete is the truth, the row delete the bookkeeping. */
+    private suspend fun purge(entities: List<MediaDownloadEntity>): Long {
+        var freed = 0L
+        entities.forEach { entity ->
+            if (File(entity.destPath).delete()) freed += entity.downloadedBytes
+        }
+        dao.deleteByKeys(entities.map(MediaDownloadEntity::mediaKey))
+        return freed
+    }
+
+    private companion object {
+        const val DAY_MS = 24L * 60 * 60 * 1000
+        const val EVICT_BATCH = 32
+
+        /** Room stores the columns as text; the string constants equal the enum names on purpose. */
+        private fun MediaCategory.toColumn(): String = when (this) {
+            MediaCategory.PHOTO -> MediaDownloadEntity.CATEGORY_PHOTO
+            MediaCategory.VIDEO -> MediaDownloadEntity.CATEGORY_VIDEO
+            MediaCategory.AUDIO -> MediaDownloadEntity.CATEGORY_AUDIO
+            MediaCategory.DOCUMENT -> MediaDownloadEntity.CATEGORY_DOCUMENT
+            MediaCategory.OTHER -> MediaDownloadEntity.CATEGORY_OTHER
+        }
+
+        private fun MediaOwnerType.toColumn(): String = when (this) {
+            MediaOwnerType.DIALOG -> MediaDownloadEntity.OWNER_DIALOG
+            MediaOwnerType.PROFILE -> MediaDownloadEntity.OWNER_PROFILE
+            MediaOwnerType.SAVED_PHOTO -> MediaDownloadEntity.OWNER_SAVED_PHOTO
+            MediaOwnerType.ARCHIVE_FOLDER -> MediaDownloadEntity.OWNER_ARCHIVE_FOLDER
+        }
+
+        private fun MediaUsageSummary.toDomain() = MediaUsage(
+            category = category ?: label,
+            ownerType = ownerType?.takeIf { it.isNotEmpty() },
+            ownerId = ownerId?.takeIf { it.isNotEmpty() },
+            bytes = bytes,
+            files = files,
+            label = label.takeIf { ownerType?.isNotEmpty() == true },
+        )
+
+        private fun MediaDownloadEntity.toDomain(): MediaDownloadState = when (status) {
+            MediaDownloadEntity.STATUS_QUEUED -> MediaDownloadState.Queued(downloadedBytes, totalBytes)
+            MediaDownloadEntity.STATUS_DOWNLOADING -> MediaDownloadState.Running(
+                bytesDownloaded = downloadedBytes,
+                totalBytes = totalBytes,
+                fraction = fractionOf(downloadedBytes, totalBytes),
+            )
+            MediaDownloadEntity.STATUS_PAUSED -> MediaDownloadState.Paused(downloadedBytes, totalBytes)
+            MediaDownloadEntity.STATUS_FAILED -> MediaDownloadState.Failed(failReason, downloadedBytes)
+            MediaDownloadEntity.STATUS_COMPLETED -> MediaDownloadState.Completed(destPath, downloadedBytes)
+            else -> MediaDownloadState.Idle
+        }
+
+        private fun DownloadRequest.toEntity(cacheDir: File, now: Long): MediaDownloadEntity =
+            MediaDownloadEntity(
+                mediaKey = mediaKey,
+                attachmentId = attachmentId,
+                profileId = profileId,
+                dialogId = dialogId,
+                ownerId = when (ownerType) {
+                    MediaOwnerType.DIALOG -> dialogId.orEmpty()
+                    else -> profileId
+                },
+                ownerType = ownerType.toColumn(),
+                category = category.toColumn(),
+                remoteUrl = remoteUrl,
+                localSourcePath = localSourcePath,
+                destPath = MediaFiles.destination(cacheDir, mediaKey, extension).absolutePath,
+                status = MediaDownloadEntity.STATUS_QUEUED,
+                downloadedBytes = 0L,
+                totalBytes = MediaDownloadEntity.SIZE_UNKNOWN,
+                etag = null,
+                lastModified = null,
+                acceptRanges = false,
+                failReason = null,
+                createdAt = now,
+                updatedAt = now,
+                lastAccessedAt = now,
+            )
+
+        private fun fractionOf(bytes: Long, total: Long): Float? =
+            if (total > 0) (bytes.toFloat() / total).coerceIn(0f, 1f) else null
+    }
+}
