new file mode 100644
index 0000000..bd745e5
--- /dev/null
+++ b/core/storage/src/main/kotlin/com/etozhesandy/redpanda/core/storage/db/mediadownload/MediaDownloadEntity.kt
@@ -0,0 +1,93 @@
+package com.etozhesandy.redpanda.core.storage.db.mediadownload
+
+import androidx.room.Entity
+import androidx.room.Index
+import androidx.room.PrimaryKey
+
+/**
+ * One row per media artifact the reader is asked for at full quality, tracking both the resumable
+ * download (offsets, validators) and the cache metadata the Storage Usage screen reads (category,
+ * owner, sizes, last access).
+ *
+ * It is deliberately a separate table rather than columns on `attachments`: attachment rows are
+ * immutable dump content that survives re-imports, while this is volatile cache state keyed by a
+ * deterministic [mediaKey] — same media, same key, across restarts and re-imports of the same
+ * archive. Rows with [STATUS_COMPLETED] are the cache: their [destPath] file exists and
+ * [downloadedBytes] equals its size.
+ *
+ * [remoteUrl] and [localSourcePath] are mutually exclusive sources: a remote fetch resumes over
+ * HTTP `Range` against the CDN, a local-archive copy resumes from the last written byte of the
+ * dump file. Exactly one is set at enqueue time.
+ */
+@Entity(
+    tableName = "media_downloads",
+    indices = [
+        // The Storage Usage screen groups cache by category and by dialog/profile; both read the
+        // whole table, so the indexes serve the group-by scans and the per-owner filters.
+        Index(value = ["ownerType", "ownerId"]),
+        Index(value = ["category"]),
+        // The downloader asks "what is running" on recovery and the UI on open; without this the
+        // status filter scans every completed row of a long session.
+        Index(value = ["status"]),
+        // LRU eviction and the auto-remove sweep order by access time and drop the oldest first.
+        Index(value = ["lastAccessedAt"]),
+    ],
+)
+data class MediaDownloadEntity(
+    /** `sha256(profileId | sourceKind | path-or-url)` — see MediaKeys in core/mediadownload. */
+    @PrimaryKey val mediaKey: String,
+    /** `attachments.id` when the media is a message/profile attachment; null for avatars and covers. */
+    val attachmentId: String?,
+    /** The imported profile the media belongs to; the per-profile storage tab groups on it. */
+    val profileId: String,
+    /** The dialog the media belongs to; null when the media is not inside a conversation. */
+    val dialogId: String?,
+    /** The id of the owner ([profileId]/[dialogId]/folder name), so one index serves every tab. */
+    val ownerId: String,
+    /** One of [OWNER_DIALOG], [OWNER_PROFILE], [OWNER_SAVED_PHOTO], [OWNER_ARCHIVE_FOLDER]. */
+    val ownerType: String,
+    /** One of [CATEGORY_PHOTO], [CATEGORY_VIDEO], [CATEGORY_AUDIO], [CATEGORY_DOCUMENT], [CATEGORY_OTHER]. */
+    val category: String,
+    val remoteUrl: String?,
+    val localSourcePath: String?,
+    /** Where the full-quality file lives (or will live): `cacheDir/media/<mediaKey>.<ext>`. */
+    val destPath: String,
+    /** One of the STATUS_ constants below; stored as text so a new status needs no migration. */
+    val status: String,
+    /** Bytes already on disk at [destPath]. On completion this equals the file size. */
+    val downloadedBytes: Long,
+    /** [SIZE_UNKNOWN] until the source reports a length; local copies know it up front. */
+    val totalBytes: Long,
+    /** HTTP validators for safe resume: a changed response means the offset is meaningless. */
+    val etag: String?,
+    val lastModified: String?,
+    /** Whether the source accepted a ranged request; a source without range support restarts. */
+    val acceptRanges: Boolean,
+    /** Why the last attempt failed; null while the download has never failed. */
+    val failReason: String?,
+    val createdAt: Long,
+    val updatedAt: Long,
+    /** Bumped on every cache hit; LRU eviction and auto-remove purge on this. */
+    val lastAccessedAt: Long,
+) {
+    companion object {
+        const val SIZE_UNKNOWN = -1L
+
+        const val STATUS_QUEUED = "QUEUED"
+        const val STATUS_DOWNLOADING = "DOWNLOADING"
+        const val STATUS_PAUSED = "PAUSED"
+        const val STATUS_COMPLETED = "COMPLETED"
+        const val STATUS_FAILED = "FAILED"
+
+        const val OWNER_DIALOG = "DIALOG"
+        const val OWNER_PROFILE = "PROFILE"
+        const val OWNER_SAVED_PHOTO = "SAVED_PHOTO"
+        const val OWNER_ARCHIVE_FOLDER = "ARCHIVE_FOLDER"
+
+        const val CATEGORY_PHOTO = "PHOTO"
+        const val CATEGORY_VIDEO = "VIDEO"
+        const val CATEGORY_AUDIO = "AUDIO"
+        const val CATEGORY_DOCUMENT = "DOCUMENT"
+        const val CATEGORY_OTHER = "OTHER"
+    }
+}
