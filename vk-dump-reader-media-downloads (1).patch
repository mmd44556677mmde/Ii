+/** The fixed palette per cache category — the donut and its legend rows share these colours. */
+private fun categoryColor(key: String) = when (key) {
+    "PHOTO" -> Color(0xFF4CAF50)
+    "VIDEO" -> Color(0xFFE53935)
+    "AUDIO" -> Color(0xFF7E57C2)
+    "DOCUMENT" -> Color(0xFF42A5F5)
+    else -> Color(0xFFFFA726)
+}
+
+private fun categoryLabelRes(key: String) = when (key) {
+    "PHOTO" -> R.string.storage_category_photos
+    "VIDEO" -> R.string.storage_category_videos
+    "AUDIO" -> R.string.storage_category_music
+    "DOCUMENT" -> R.string.storage_category_files
+    else -> R.string.storage_category_other
+}
+
+/** The per-dialog tabs mirror Telegram's: everything, then one media kind at a time. */
+private val OWNER_TABS = listOf(
+    null to R.string.storage_tab_all,
+    "PHOTO" to R.string.storage_category_photos,
+    "VIDEO" to R.string.storage_category_videos,
+    "AUDIO" to R.string.storage_category_music,
+    "DOCUMENT" to R.string.storage_category_files,
+)
+
+/**
+ * The cache manager: what full-quality media the reader has downloaded, how much of the device
+ * it takes, and the controls Telegram taught users to look for — per-category clearing ("the
+ * file downloads again the next time you open it"), per-category auto-remove, and an LRU
+ * ceiling. Every number is read from the download table, none is estimated.
+ */
+@Composable
+fun StorageUsageScreen(
+    state: StorageUsageState.State,
+    effect: Flow<StorageUsageState.Effect>,
+    onEvent: (StorageUsageState.Event) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val context = LocalContext.current
+    LaunchedEffect(Unit) {
+        effect.collectLatest { current ->
+            when (current) {
+                is StorageUsageState.Effect.Cleared ->
+                    Toast.makeText(
+                        context,
+                        context.getString(R.string.storage_cleared_toast, formatBytes(context, current.bytes)),
+                        Toast.LENGTH_SHORT,
+                    ).show()
+            }
+        }
+    }
+
+    BaseScreen(
+        title = stringResource(R.string.storage_title),
+        modifier = modifier,
+        onBack = { onEvent(StorageUsageState.Event.BackClicked) },
+    ) {
+        var tab by remember { mutableIntStateOf(0) }
+        StorageTabSwitcher(selectedIndex = tab, onSelected = { tab = it })
+
+        if (tab == 0) {
+            OverviewTab(state = state, onEvent = onEvent)
+        } else {
+            OwnersTab(state = state, onEvent = onEvent)
+        }
+    }
+}
+
+@Composable
+private fun StorageTabSwitcher(selectedIndex: Int, onSelected: (Int) -> Unit) {
+    // Two fixed tabs; a plain segmented row keeps the screen free of a TabRow interop dance.
+    Row(modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)) {
+        FilterChip(
+            selected = selectedIndex == 0,
+            onClick = { onSelected(0) },
+            label = { Text(stringResource(R.string.storage_tab_overview)) },
+        )
+        FilterChip(
+            selected = selectedIndex == 1,
+            onClick = { onSelected(1) },
+            label = { Text(stringResource(R.string.storage_tab_by_dialog)) },
+            modifier = Modifier.padding(start = 8.dp),
+        )
+    }
+}
+
+@Composable
+private fun OverviewTab(state: StorageUsageState.State, onEvent: (StorageUsageState.Event) -> Unit) {
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .verticalScroll(rememberScrollState())
+            .padding(bottom = 16.dp),
+    ) {
+        if (state.isEmpty) {
+            Text(
+                text = stringResource(R.string.storage_empty),
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(24.dp),
+            )
+            return@Column
+        }
+
+        val context = LocalContext.current
+        val segments = state.categories.map { row ->
+            DonutSegment(label = row.key, bytes = row.bytes, color = categoryColor(row.key))
+        }
+        Row(
+            modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 12.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            StorageDonutChart(
+                segments = segments,
+                totalBytesLabel = formatBytes(context, state.totalBytes),
+                modifier = Modifier.padding(end = 16.dp),
+            )
+            Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                Text(
+                    text = stringResource(R.string.storage_device_share, state.deviceSharePercent),
+                    style = MaterialTheme.typography.bodyMedium,
+                )
+                Text(
+                    text = stringResource(R.string.storage_re_download_hint),
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+        }
+
+        state.categories.forEach { row ->
+            CategoryRow(state = state, row = row, onEvent = onEvent)
+            HorizontalDivider()
+        }
+
+        val anySelected = state.categories.any { it.isSelected }
+        Button(
+            onClick = { onEvent(StorageUsageState.Event.ClearSelectedClicked) },
+            enabled = anySelected && !state.isClearing,
+            modifier = Modifier.padding(horizontal = 16.dp, vertical = 12.dp),
+        ) {
+            Text(stringResource(R.string.storage_clear_selected))
+        }
+
+        MaxCacheSection(state = state, onEvent = onEvent)
+    }
+}
+
+@Composable
+private fun CategoryRow(
+    state: StorageUsageState.State,
+    row: StorageUsageState.CategoryUsage,
+    onEvent: (StorageUsageState.Event) -> Unit,
+) {
+    val context = LocalContext.current
+    var pickerShown by remember { mutableStateOf(false) }
+    ListItem(
+        modifier = Modifier.clickable { onEvent(StorageUsageState.Event.CategoryToggled(row.key, !row.isSelected)) },
+        leadingContent = {
+            Checkbox(checked = row.isSelected, onCheckedChange = { onEvent(StorageUsageState.Event.CategoryToggled(row.key, it)) })
+        },
+        headlineContent = { Text(stringResource(categoryLabelRes(row.key))) },
+        supportingContent = {
+            Text(stringResource(R.string.storage_files_count, row.files))
+        },
+        trailingContent = {
+            Column(horizontalAlignment = Alignment.End) {
+                Text(formatBytes(context, row.bytes), style = MaterialTheme.typography.bodyMedium)
+                TextButton(onClick = { pickerShown = true }) {
+                    Text(stringResource(autoCleanLabelRes(state.autoCleanDays[row.key] ?: 0)))
+                }
+            }
+        },
+    )
+    if (pickerShown) {
+        AutoCleanDialog(
+            category = row.key,
+            currentDays = state.autoCleanDays[row.key] ?: 0,
+            onPick = { days ->
+                onEvent(StorageUsageState.Event.AutoCleanChanged(row.key, days))
+                pickerShown = false
+            },
+            onDismiss = { pickerShown = false },
+        )
+    }
+}
+
+private fun autoCleanLabelRes(days: Int) = when (days) {
+    2 -> R.string.storage_auto_clean_two
+    30 -> R.string.storage_auto_clean_month
+    else -> R.string.storage_auto_clean_never
+}
+
+@Composable
+private fun AutoCleanDialog(
+    category: String,
+    currentDays: Int,
+    onPick: (Int) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(categoryLabelRes(category))) },
+        text = {
+            Column {
+                listOf(0 to R.string.storage_auto_clean_never, 2 to R.string.storage_auto_clean_two, 30 to R.string.storage_auto_clean_month)
+                    .forEach { (days, labelRes) ->
+                        ListItem(
+                            headlineContent = { Text(stringResource(labelRes)) },
+                            leadingContent = { RadioButton(selected = days == currentDays, onClick = null) },
+                            modifier = Modifier.fillMaxWidth().clickable { onPick(days) },
+                        )
+                    }
+            }
+        },
+        confirmButton = {},
+        dismissButton = {
+            TextButton(onClick = onDismiss) { Text(stringResource(R.string.storage_close)) }
+        },
+    )
+}
+
+@Composable
+private fun MaxCacheSection(state: StorageUsageState.State, onEvent: (StorageUsageState.Event) -> Unit) {
+    Text(
+        text = stringResource(R.string.storage_max_cache),
+        style = MaterialTheme.typography.titleSmall,
+        color = MaterialTheme.colorScheme.primary,
+        modifier = Modifier.padding(start = 16.dp, top = 8.dp),
+    )
+    Row(modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)) {
+        FilterChip(
+            selected = state.maxCacheSizeBytes == 0L,
+            onClick = { onEvent(StorageUsageState.Event.MaxCacheChanged(0L)) },
+            label = { Text(stringResource(R.string.storage_cache_unlimited)) },
+        )
+        listOf(5 to R.string.storage_cache_5gb, 16 to R.string.storage_cache_16gb, 32 to R.string.storage_cache_32gb)
+            .forEach { (gb, labelRes) ->
+                FilterChip(
+                    selected = state.maxCacheSizeBytes == gb.toLong() * GB,
+                    onClick = { onEvent(StorageUsageState.Event.MaxCacheChanged(gb.toLong() * GB)) },
+                    label = { Text(stringResource(labelRes)) },
+                    modifier = Modifier.padding(start = 8.dp),
+                )
+            }
+    }
+}
+
+@Composable
+private fun OwnersTab(state: StorageUsageState.State, onEvent: (StorageUsageState.Event) -> Unit) {
+    val context = LocalContext.current
+    var categoryTab by remember { mutableIntStateOf(0) }
+    Row(modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp)) {
+        OWNER_TABS.take(3).forEachIndexed { index, (_, labelRes) ->
+            FilterChip(
+                selected = categoryTab == index,
+                onClick = { categoryTab = index },
+                label = { Text(stringResource(labelRes)) },
+                modifier = Modifier.padding(end = 8.dp),
+            )
+        }
+    }
+    Row(modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 4.dp)) {
+        OWNER_TABS.drop(3).forEachIndexed { index, (_, labelRes) ->
+            FilterChip(
+                selected = categoryTab == index + 3,
+                onClick = { categoryTab = index + 3 },
+                label = { Text(stringResource(labelRes)) },
+                modifier = Modifier.padding(end = 8.dp),
+            )
+        }
+    }
+
+    val selectedCategory = OWNER_TABS[categoryTab].first
+    val rows = state.ownerUsage
+        .filter { selectedCategory == null || it.category == selectedCategory }
+        .groupBy { (it.ownerType ?: "") to (it.ownerId ?: "") }
+        .map { (owner, parts) ->
+            StorageUsageState.OwnerUsage(
+                ownerType = owner.first,
+                ownerId = owner.second,
+                label = state.ownerLabels[owner.second] ?: owner.second,
+                bytes = parts.sumOf { it.bytes },
+                files = parts.sumOf { it.files },
+            )
+        }
+        .sortedByDescending { it.bytes }
+
+    if (rows.isEmpty()) {
+        Text(
+            text = stringResource(R.string.storage_empty),
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(24.dp),
+        )
+        return
+    }
+
+    Column(modifier = Modifier.fillMaxWidth().verticalScroll(rememberScrollState())) {
+        rows.forEach { row ->
+            ListItem(
+                headlineContent = { Text(row.label) },
+                supportingContent = {
+                    Text(stringResource(ownerTypeLabelRes(row.ownerType)) + " · " + stringResource(R.string.storage_files_count, row.files))
+                },
+                trailingContent = {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Text(formatBytes(context, row.bytes), style = MaterialTheme.typography.bodyMedium)
+                        IconButton(onClick = { onEvent(StorageUsageState.Event.OwnerPurgeClicked(row.ownerType, row.ownerId)) }) {
+                            Icon(
+                            Icons.Default.Delete,
+                            contentDescription = stringResource(R.string.storage_clear_owner),
+                        )
+                        }
+                    }
+                },
+            )
+            HorizontalDivider()
+        }
+    }
+}
+
+private fun ownerTypeLabelRes(ownerType: String) = when (ownerType) {
+    "DIALOG" -> R.string.storage_owner_dialog
+    "PROFILE" -> R.string.storage_owner_profile
+    "SAVED_PHOTO" -> R.string.storage_owner_saved
+    else -> R.string.storage_owner_folder
+}
+
+private const val GB = 1024L * 1024 * 1024
