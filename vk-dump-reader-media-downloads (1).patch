+++ b/features/settings/src/main/kotlin/com/etozhesandy/redpanda/features/settings/presentation/storage/StorageUsageViewModel.kt
@@ -0,0 +1,117 @@
+package com.etozhesandy.redpanda.features.settings.presentation.storage
+
+import android.os.StatFs
+import androidx.lifecycle.viewModelScope
+import com.etozhesandy.redpanda.core.common.mvi.BaseViewModel
+import com.etozhesandy.redpanda.core.mediadownload.domain.repository.MediaDownloadRepository
+import com.etozhesandy.redpanda.core.navigation.Routes
+import com.etozhesandy.redpanda.core.navigation.manager.INavigationManager
+import com.etozhesandy.redpanda.core.settings.SettingsRepository
+import dagger.hilt.android.lifecycle.HiltViewModel
+import javax.inject.Inject
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.onEach
+
+/**
+ * Streams the real cache numbers: everything comes from the `media_downloads` table (completed
+ * rows only — a paused download's bytes are not cache) and the device share from a `StatFs` read
+ * over the cache directory's volume. Nothing here is estimated.
+ */
+@HiltViewModel
+class StorageUsageViewModel @Inject constructor(
+    private val repository: MediaDownloadRepository,
+    private val settingsRepository: SettingsRepository,
+    private val nav: INavigationManager,
+) : BaseViewModel<StorageUsageState.State, StorageUsageState.Event, StorageUsageState.Effect>() {
+
+    override fun createInitialState() = StorageUsageState.State()
+
+    init {
+        combine(
+            repository.observeTotalCachedBytes(),
+            repository.observeUsageByCategory(),
+            repository.observeUsageByOwner(),
+            repository.observeUsageByOwnerNamed(),
+            settingsRepository.settings,
+        ) { total, byCategory, byOwner, byOwnerNamed, settings ->
+            Quintuple(total, byCategory, byOwner, byOwnerNamed, settings)
+        }
+            .onEach { (total, byCategory, byOwner, byOwnerNamed, settings) ->
+                val labels = byOwnerNamed.mapNotNull { row ->
+                    row.ownerId?.let { it to (row.label ?: it) }
+                }.toMap()
+                setState {
+                    copy(
+                        totalBytes = total,
+                        deviceSharePercent = deviceSharePercent(total),
+                        categories = byCategory
+                            .sortedByDescending { it.bytes }
+                            .map { row ->
+                                StorageUsageState.CategoryUsage(
+                                    key = row.category,
+                                    bytes = row.bytes,
+                                    files = row.files,
+                                    isSelected = categories.firstOrNull { it.key == row.category }?.isSelected ?: false,
+                                )
+                            },
+                        ownerUsage = byOwner.sortedByDescending { it.bytes },
+                        ownerLabels = labels,
+                        maxCacheSizeBytes = settings.maxMediaCacheSizeBytes,
+                        autoCleanDays = mapOf(
+                            "PHOTO" to settings.mediaAutoCleanPhotoDays,
+                            "VIDEO" to settings.mediaAutoCleanVideoDays,
+                            "AUDIO" to settings.mediaAutoCleanAudioDays,
+                            "DOCUMENT" to settings.mediaAutoCleanDocumentDays,
+                            "OTHER" to settings.mediaAutoCleanOtherDays,
+                        ),
+                        isEmpty = total == 0L,
+                    )
+                }
+            }
+            .launchIn(viewModelScope)
+    }
+
+    override fun onEvent(event: StorageUsageState.Event) {
+        when (event) {
+            StorageUsageState.Event.BackClicked -> nav.back()
+            is StorageUsageState.Event.CategoryToggled -> setState {
+                copy(
+                    categories = categories.map { row ->
+                        if (row.key == event.key) row.copy(isSelected = event.selected) else row
+                    },
+                )
+            }
+            StorageUsageState.Event.ClearSelectedClicked -> launchSafe {
+                val selected = currentState.categories.filter { it.isSelected }.map { it.key }.toSet()
+                if (selected.isEmpty()) return@launchSafe
+                setState { copy(isClearing = true) }
+                val freed = repository.purgeCategories(selected)
+                setState { copy(isClearing = false) }
+                setEffect { StorageUsageState.Effect.Cleared(freed) }
+            }
+            is StorageUsageState.Event.OwnerPurgeClicked -> launchSafe {
+                val freed = repository.purgeOwner(event.ownerType, event.ownerId)
+                setEffect { StorageUsageState.Effect.Cleared(freed) }
+            }
+            is StorageUsageState.Event.AutoCleanChanged -> launchSafe {
+                settingsRepository.setMediaAutoCleanDays(event.category, event.days)
+            }
+            is StorageUsageState.Event.MaxCacheChanged -> launchSafe {
+                settingsRepository.setMaxMediaCacheSizeBytes(event.bytes)
+            }
+        }
+    }
+
+    /** The cache's percent of the device volume; 0 when nothing is cached or the volume is unknown. */
+    private fun deviceSharePercent(totalBytes: Long): Int {
+        if (totalBytes <= 0L) return 0
+        val stat = StatFs(repository.cacheDirectory().absolutePath)
+        val deviceTotal = stat.totalBytes
+        if (deviceTotal <= 0L) return 0
+        return ((totalBytes * 100L + deviceTotal / 2) / deviceTotal).toInt().coerceIn(0, 100)
+    }
+
+    /** `combine` caps at five flows; this carries the five answers through. */
+    private data class Quintuple<A, B, C, D, E>(val a: A, val b: B, val c: C, val d: D, val e: E)
+}
