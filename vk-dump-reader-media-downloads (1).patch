+     */
+    fun resolvedFile(mediaKey: String?): Flow<String?>
+
+    /** True when remote images may be displayed under the current policy and network. */
+    @Composable
+    fun isRemoteDisplayAllowed(): Boolean
+
+    /**
+     * The user tapped a media tile. Decides between opening the viewer (calls [open]) and
+     * starting or parking the download (leaves the tile on screen with its progress ring).
+     */
+    fun onTileTap(attachment: Attachment, open: () -> Unit)
+
+    /**
+     * The user tapped a video tile: playback starts immediately. Starts the fetch (policy
+     * permitting) and calls [open] either way — the player buffers over the growing file.
+     */
+    fun onVideoTileTap(attachment: Attachment, open: () -> Unit)
+
+    /** A viewer page became visible: fetch the full-quality copy without waiting for a tap. */
+    fun onViewerPageOpen(attachment: Attachment)
+
+    /** The video player page went away: pause the fetch behind it, keeping every byte. */
+    fun onVideoPageClosed(mediaKey: String?)
+
+    /** In-player download controls: pause at the current offset / continue from it. */
+    fun pauseDownload(mediaKey: String?)
+
+    fun resumeDownload(mediaKey: String?)
+
+    /**
+     * The source factory that plays a video whose file is still being appended to; null lets the
+     * player fall back to its default source (local files, no key).
+     */
+    fun videoSourceFactory(mediaKey: String?): DataSource.Factory?
+
+    /** True while an Ask-policy request waits for the user's answer. */
+    val isConfirmationPending: MutableStateFlow<Boolean>
+
+    /** Accepts the pending Ask-policy request. */
+    fun acceptPendingConfirmation()
+
+    /** Dismisses the pending Ask-policy request. */
+    fun denyPendingConfirmation()
+}
+
+/** Placeholder used before the app wires the real controller: local media behaves, remote opens. */
+object NoOpRemoteTileController : RemoteTileController {
+
+    override fun mediaKeyOf(profileId: String, type: AttachmentType, path: String): String? = null
+
+    @Composable
+    override fun tileState(mediaKey: String?): TileMediaState = TileMediaState.Hidden
+
+    override fun resolvedFile(mediaKey: String?): Flow<String?> = flowOf(null)
+
+    @Composable
+    override fun isRemoteDisplayAllowed(): Boolean = true
+
+    override fun onTileTap(attachment: Attachment, open: () -> Unit) = open()
+
+    override fun onVideoTileTap(attachment: Attachment, open: () -> Unit) = open()
+
+    override fun onViewerPageOpen(attachment: Attachment) = Unit
+
+    override fun onVideoPageClosed(mediaKey: String?) = Unit
+
+    override fun pauseDownload(mediaKey: String?) = Unit
+
+    override fun resumeDownload(mediaKey: String?) = Unit
+
+    override fun videoSourceFactory(mediaKey: String?): DataSource.Factory? = null
+
+    override val isConfirmationPending: MutableStateFlow<Boolean> = MutableStateFlow(false)
+
+    override fun acceptPendingConfirmation() = Unit
+
+    override fun denyPendingConfirmation() = Unit
+}
+
+/** Provided once at the app root; previews and design-system demos fall back to [NoOpRemoteTileController]. */
+val LocalRemoteTileController = staticCompositionLocalOf<RemoteTileController> { NoOpRemoteTileController }
