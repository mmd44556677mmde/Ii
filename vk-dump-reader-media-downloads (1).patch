+++ b/core/storage/src/main/kotlin/com/etozhesandy/redpanda/core/storage/db/mediadownload/MediaDownloadDao.kt
@@ -0,0 +1,133 @@
+package com.etozhesandy.redpanda.core.storage.db.mediadownload
+
+import androidx.room.Dao
+import androidx.room.Query
+import androidx.room.Upsert
+import kotlinx.coroutines.flow.Flow
+
+/**
+ * Every write the downloader performs is a single-row [Upsert] or a targeted [Query] update: the
+ * offset column is the crash-survival contract, so progress is persisted per chunk, never batched
+ * in memory. Reads split into the one-key lookups the UI observes and the aggregates the Storage
+ * Usage screen streams.
+ */
+@Dao
+interface MediaDownloadDao {
+
+    @Query("SELECT * FROM media_downloads WHERE mediaKey = :mediaKey")
+    fun observe(mediaKey: String): Flow<MediaDownloadEntity?>
+
+    @Query("SELECT * FROM media_downloads WHERE mediaKey = :mediaKey")
+    suspend fun get(mediaKey: String): MediaDownloadEntity?
+
+    @Upsert
+    suspend fun upsert(entity: MediaDownloadEntity)
+
+    /** The one-line progress write, run once per downloaded chunk. */
+    @Query(
+        "UPDATE media_downloads SET status = :status, downloadedBytes = :downloadedBytes, " +
+            "totalBytes = :totalBytes, updatedAt = :updatedAt WHERE mediaKey = :mediaKey",
+    )
+    suspend fun updateProgress(
+        mediaKey: String,
+        status: String,
+        downloadedBytes: Long,
+        totalBytes: Long,
+        updatedAt: Long,
+    )
+
+    @Query(
+        "UPDATE media_downloads SET etag = :etag, lastModified = :lastModified, " +
+            "acceptRanges = :acceptRanges, totalBytes = :totalBytes WHERE mediaKey = :mediaKey",
+    )
+    suspend fun updateValidators(
+        mediaKey: String,
+        etag: String?,
+        lastModified: String?,
+        acceptRanges: Boolean,
+        totalBytes: Long,
+    )
+
+    @Query(
+        "UPDATE media_downloads SET status = :status, failReason = :failReason, " +
+            "updatedAt = :updatedAt WHERE mediaKey = :mediaKey",
+    )
+    suspend fun updateStatus(mediaKey: String, status: String, failReason: String?, updatedAt: Long)
+
+    @Query("UPDATE media_downloads SET lastAccessedAt = :accessedAt WHERE mediaKey = :mediaKey")
+    suspend fun touch(mediaKey: String, accessedAt: Long)
+
+    // Recovery: rows stuck DOWNLOADING/QUEUED mean the process died mid-transfer. They are
+    // demoted to PAUSED with their offsets intact, so the next tap resumes, never restarts.
+    @Query(
+        "UPDATE media_downloads SET status = 'PAUSED', updatedAt = :updatedAt " +
+            "WHERE status IN ('DOWNLOADING', 'QUEUED')",
+    )
+    suspend fun demoteRunningToPaused(updatedAt: Long): Int
+
+    // --- Storage Usage screen -------------------------------------------------------------
+
+    @Query(
+        "SELECT category AS label, '' AS ownerType, '' AS ownerId, category, " +
+            "SUM(downloadedBytes) AS bytes, COUNT(*) AS files " +
+            "FROM media_downloads WHERE status = 'COMPLETED' GROUP BY category",
+    )
+    fun observeUsageByCategory(): Flow<List<MediaUsageSummary>>
+
+    @Query(
+        "SELECT ownerType, ownerId, category, ownerId AS label, " +
+            "SUM(downloadedBytes) AS bytes, COUNT(*) AS files " +
+            "FROM media_downloads WHERE status = 'COMPLETED' " +
+            "GROUP BY ownerType, ownerId, category",
+    )
+    fun observeUsageByOwner(): Flow<List<MediaUsageSummary>>
+
+    /**
+     * One row per owner with a human label: the profile's custom/display name or the dialog's
+     * peer name, falling back to the raw id for rows whose owner vanished (a deleted profile's
+     * leftover cache). Largest first — the screen lists them, it does not sort them.
+     */
+    @Query(
+        "SELECT m.ownerType AS ownerType, m.ownerId AS ownerId, '' AS category, " +
+            "COALESCE(p.customName, p.displayName, d.peerName, m.ownerId) AS label, " +
+            "SUM(m.downloadedBytes) AS bytes, COUNT(*) AS files " +
+            "FROM media_downloads m " +
+            "LEFT JOIN profiles p ON p.id = m.ownerId " +
+            "LEFT JOIN dialogs d ON d.id = m.ownerId " +
+            "WHERE m.status = 'COMPLETED' " +
+            "GROUP BY m.ownerType, m.ownerId " +
+            "ORDER BY bytes DESC",
+    )
+    fun observeUsageByOwnerNamed(): Flow<List<MediaUsageSummary>>
+
+    @Query("SELECT SUM(downloadedBytes) FROM media_downloads WHERE status = 'COMPLETED'")
+    fun observeCompletedBytes(): Flow<Long?>
+
+    /** Synchronous read for the LRU eviction loop, which re-checks after every eviction. */
+    @Query("SELECT SUM(downloadedBytes) FROM media_downloads WHERE status = 'COMPLETED'")
+    suspend fun completedBytesSum(): Long?
+
+    /** Oldest-first completed rows, the eviction candidates. */
+    @Query(
+        "SELECT * FROM media_downloads WHERE status = 'COMPLETED' " +
+            "ORDER BY lastAccessedAt ASC LIMIT :limit",
+    )
+    suspend fun oldestCompleted(limit: Int): List<MediaDownloadEntity>
+
+    @Query(
+        "SELECT * FROM media_downloads WHERE status = 'COMPLETED' AND lastAccessedAt < :threshold",
+    )
+    suspend fun completedNotAccessedSince(threshold: Long): List<MediaDownloadEntity>
+
+    @Query("SELECT * FROM media_downloads WHERE status = 'COMPLETED' AND category = :category")
+    suspend fun completedByCategory(category: String): List<MediaDownloadEntity>
+
+    @Query(
+        "SELECT * FROM media_downloads WHERE status = 'COMPLETED' " +
+            "AND ownerType = :ownerType AND ownerId = :ownerId",
+    )
+    suspend fun completedByOwner(ownerType: String, ownerId: String): List<MediaDownloadEntity>
+
+    @Query("DELETE FROM media_downloads WHERE mediaKey IN (:mediaKeys)")
+    suspend fun deleteByKeys(mediaKeys: List<String>)
+}
