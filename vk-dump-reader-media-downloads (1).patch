+package com.etozhesandy.redpanda.core.mediadownload.data.downloader
+
+import java.security.MessageDigest
+
+/** Derives the stable primary key a media artifact is tracked and re-found by. */
+object MediaKeys {
+
+    /**
+     * `sha256(profileId | sourceKind | path-or-url)`. Stable across restarts and re-imports of
+     * the same archive: the same attachment or CDN link always maps to the same row, so a resumed
+     * download and its row find each other without a join. [sourceKind] is any short discriminator
+     * the caller picks ("photo", "video-file", "avatar", ...) to keep an attachment whose source
+     * changes between renders (a video still vs its file) from colliding on one row.
+     */
+    fun of(profileId: String, sourceKind: String, pathOrUrl: String): String {
+        val digest = MessageDigest.getInstance("SHA-256")
+            .digest("$profileId|$sourceKind|$pathOrUrl".toByteArray())
+        return digest.joinToString("") { "%02x".format(it) }
+    }
+}
