+package com.etozhesandy.redpanda.core.mediadownload.domain.model
+
+/**
+ * The observable state of one media artifact's full-quality copy.
+ *
+ * [Paused], [Failed] and [Completed] carry what the UI needs to act: the byte offset a resume
+ * continues from, the reason a tile shows "retry", and the file a viewer opens directly.
+ * [Running] is the only state whose flow emits repeatedly — once per chunk, cheap enough to drive
+ * a progress ring.
+ */
+sealed interface MediaDownloadState {
+
+    /** No row, or a row the user cleared. Nothing has been fetched for this media. */
+    data object Idle : MediaDownloadState
+
+    /** Enqueued, waiting for a download slot. [bytesDownloaded] may be non-zero after a resume. */
+    data class Queued(val bytesDownloaded: Long, val totalBytes: Long) : MediaDownloadState
+
+    data class Running(
+        val bytesDownloaded: Long,
+        val totalBytes: Long,
+        /** 0f..1f, or null while [totalBytes] is unknown. */
+        val fraction: Float?,
+    ) : MediaDownloadState
+
+    /** Stopped by the user, by leaving the screen, or by process death — progress is kept. */
+    data class Paused(val bytesDownloaded: Long, val totalBytes: Long) : MediaDownloadState
+
+    data class Failed(val message: String?, val bytesDownloaded: Long) : MediaDownloadState
+
+    /**
+     * The request never started because of the "Load remote media" policy: Wi-Fi-only and the
+     * network is metered, or the user set Ask and has not answered, or Never. The tile shows why
+     * instead of spinning forever, and the row stays out of the way. (Produced by the policy gate
+     * wired up alongside the settings screen in the media-UI phase.)
+     */
+    data class Blocked(val reason: String) : MediaDownloadState
+
+    data class Completed(val file: String, val sizeBytes: Long) : MediaDownloadState
+
+    val isTerminal: Boolean
+        get() = this is Completed || this is Failed
+}
