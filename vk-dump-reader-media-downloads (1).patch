diff --git a/core/storage/src/main/kotlin/com/etozhesandy/redpanda/core/storage/db/migration/Migration7To8.kt b/core/storage/src/main/kotlin/com/etozhesandy/redpanda/core/storage/db/migration/Migration7To8.kt
