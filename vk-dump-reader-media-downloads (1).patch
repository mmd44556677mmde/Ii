@@ -0,0 +1,54 @@
+package com.etozhesandy.redpanda.core.mediadownload.net
+
+import com.etozhesandy.redpanda.core.common.net.UrlGuard
+import java.io.IOException
+import java.net.URI
+import okhttp3.Interceptor
+import okhttp3.Response
+
+/**
+ * The hard privacy wall around every full-quality media fetch: an OkHttp interceptor that only
+ * lets through `https` requests to hosts a VK dump can legitimately reference.
+ *
+ * The reader's contract is that it contacts nothing but the media URLs found inside the user's own
+ * imported archive. Enforcing that at the client level — rather than hoping each call site
+ * remembers — means even a future bug that passes a wrong string to the downloader fails here, at
+ * the socket, instead of quietly calling out. Parsing is strict ([UrlGuard]'s rule): a malformed
+ * URL is a rejection, not a guess.
+ *
+ * The suffixes are the host families VK dumps actually carry for media: the photo/video CDN
+ * (`*.userapi.com`), audio (`*.vkuseraudio.com`), and `vk.com`/`vk.ru` themselves for the
+ * occasional avatar or sticker served from the site. Anything else — including look-alike hosts —
+ * is refused with [DisallowedHostException], which surfaces as a broken-media tile.
+ */
+class MediaHostAllowlist private constructor(
+    private val allowedSuffixes: Set<String>,
+) {
+
+    /** Not an ordinary I/O failure: an attempt to leave the reader's contract. Never retried blindly. */
+    class DisallowedHostException(url: String) :
+        IOException("blocked non-dump media host: ${runCatching { URI(url.trim()).host }.getOrNull() ?: "unknown"}")
+
+    fun allows(url: String): Boolean {
+        if (!UrlGuard.isWebUrl(url)) return false
+        val host = runCatching { URI(url.trim()).host?.lowercase() }.getOrNull() ?: return false
+        return allowedSuffixes.any { suffix -> host == suffix || host.endsWith(".$suffix") }
+    }
+
+    fun interceptor(): Interceptor = Interceptor { chain ->
+        val url = chain.request().url.toString()
+        if (!allows(url)) throw DisallowedHostException(url)
+        chain.proceed(chain.request())
+    }
+
+    companion object {
+
+        /**
+         * Kept in one place so the downloader and Coil's loader (wired in the media-UI phase)
+         * share the exact same wall.
+         */
+        fun default(): MediaHostAllowlist = MediaHostAllowlist(
+            setOf("vk.com", "vk.ru", "userapi.com", "vkuseraudio.com"),
+        )
+    }
+}
