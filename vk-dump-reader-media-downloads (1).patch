+++ b/core/mediadownload/src/main/kotlin/com/etozhesandy/redpanda/core/mediadownload/data/datasource/GrowingFileDataSource.kt
@@ -0,0 +1,141 @@
+package com.etozhesandy.redpanda.core.mediadownload.data.datasource
+
+import android.net.Uri
+import androidx.media3.common.C
+import androidx.media3.datasource.BaseDataSource
+import androidx.media3.datasource.DataSource
+import androidx.media3.datasource.DataSpec
+import androidx.media3.datasource.TransferListener
+import java.io.File
+import java.io.IOException
+import java.io.InterruptedIOException
+import java.io.RandomAccessFile
+
+/** How the download behind the file is doing, polled only when the file's bytes run out. */
+enum class DownloadLiveness {
+    /** The full artifact is on disk; the file stops growing, EOF is the real end. */
+    COMPLETE,
+
+    /** The chunk engine is still appending — wait for more bytes, the player just buffers. */
+    GROWING,
+
+    /** Nothing is coming: paused, failed, or policy-blocked. Waiting forever would lie to the user. */
+    STALLED,
+}
+
+/** Thrown when playback needs bytes the download can no longer deliver. */
+class DownloadStalledException(message: String) : IOException(message)
+
+/**
+ * A Media3 DataSource over a file the download engine may still be appending to — the piece that
+ * makes a video playable the moment the player opens instead of after the whole file lands.
+ *
+ * The read loop is Telegram's: serve whatever bytes exist, and when the reader outruns the
+ * downloader, poll — the player sits in its buffering state, which is exactly the truth — until
+ * either the next chunk lands ([DownloadLiveness.GROWING]) or the artifact is complete
+ * ([DownloadLiveness.COMPLETE], so EOF means the actual end). A stalled download raises
+ * [DownloadStalledException] rather than spinning, so the surface shows an error instead of a
+ * frozen buffering ring. Seeking is free: a seek is just another `open` at a new offset, and
+ * until the downloader reaches it the same waiting applies.
+ *
+ * Constructed per open by a `DataSource.Factory`; the [fileProvider] indirection lets playback
+ * start before the first chunk exists (the file appears under the factory's feet).
+ */
+class GrowingFileDataSource(
+    private val fileProvider: () -> File?,
+    private val liveness: () -> DownloadLiveness,
+    transferListener: TransferListener? = null,
+) : BaseDataSource(false) {
+
+    private var randomAccess: RandomAccessFile? = null
+    private var opened = false
+    private var closed = false
+    private var position = 0L
+    private var remaining: Long = C.LENGTH_UNSET.toLong()
+
+    init {
+        if (transferListener != null) addTransferListener(transferListener)
+    }
+
+    override fun open(dataSpec: DataSpec): Long {
+        closed = false
+        position = dataSpec.position
+        remaining = if (dataSpec.length != C.LENGTH_UNSET.toLong()) dataSpec.length else C.LENGTH_UNSET.toLong()
+        opened = true
+        transferStarted(dataSpec)
+        // The length is unknowable on purpose: the file grows while this stream is open.
+        return C.LENGTH_UNSET.toLong()
+    }
+
+    override fun read(target: ByteArray, offset: Int, length: Int): Int {
+        if (!opened) throw IllegalStateException("read() before open()")
+        if (remaining == 0L) return C.RESULT_END_OF_INPUT
+
+        while (true) {
+            if (closed || Thread.currentThread().isInterrupted) {
+                // The loader cancelled (player released, new quality, seek reset): drop out without
+                // pretending this was a network failure.
+                throw InterruptedIOException("Playback source closed")
+            }
+            val file = fileProvider() ?: run {
+                waitOrThrow()
+                continue
+            }
+            val available = file.length()
+            if (position < available) {
+                val raf = randomAccess ?: RandomAccessFile(file, "r").also { randomAccess = it }
+                raf.seek(position)
+                val requested = if (remaining == C.LENGTH_UNSET.toLong()) {
+                    length
+                } else {
+                    minOf(length.toLong(), remaining).toInt()
+                }
+                val n = raf.read(target, offset, minOf(requested, (available - position).toInt()))
+                if (n > 0) {
+                    position += n
+                    if (remaining != C.LENGTH_UNSET.toLong()) remaining -= n
+                    bytesTransferred(n)
+                    return n
+                }
+                // A zero-byte read means the tail shrank underneath us (resume trims a torn
+                // write); fall through and re-poll instead of spinning on the same spot.
+                waitOrThrow()
+                continue
+            }
+            when (liveness()) {
+                DownloadLiveness.COMPLETE -> return C.RESULT_END_OF_INPUT
+                DownloadLiveness.GROWING -> waitOrThrow()
+                DownloadLiveness.STALLED -> throw DownloadStalledException(
+                    "The download behind this video is not running (paused, failed or blocked)",
+                )
+            }
+        }
+    }
+
+    override fun getUri(): Uri? = fileProvider()?.let { Uri.fromFile(it) }
+
+    override fun close() {
+        closed = true
+        randomAccess?.close()
+        randomAccess = null
+        if (opened) {
+            opened = false
+            transferEnded()
+        }
+    }
+
+    private fun waitOrThrow() {
+        if (closed || Thread.currentThread().isInterrupted) throw InterruptedIOException("Playback source closed")
+        try {
+            Thread.sleep(POLL_INTERVAL_MS)
+        } catch (interrupted: InterruptedException) {
+            Thread.currentThread().interrupt()
+            throw InterruptedIOException("Playback source closed")
+        }
+    }
+
+    private companion object {
+        /** Downloader appends every 256 KiB chunk; polling at 50 ms adds at most one chunk of lag. */
+        const val POLL_INTERVAL_MS = 50L
+    }
+}
