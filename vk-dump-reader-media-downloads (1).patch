+/**
+ * The feedback layer between a tile and its full-quality copy: the ring while the fetch runs, a
+ * "blocked" mark when the policy said no. Drawn over the image without taking touches.
+ */
+@Composable
+private fun TileStateOverlay(tileState: TileMediaState, modifier: Modifier = Modifier) {
+    when (tileState) {
+        TileMediaState.Queued, TileMediaState.Paused -> OverlayBox(modifier) {
+            DownloadProgressRing(fraction = null, modifier = Modifier.size(28.dp))
+        }
+        is TileMediaState.Downloading -> OverlayBox(modifier) {
+            DownloadProgressRing(fraction = tileState.fraction, modifier = Modifier.size(28.dp))
+        }
+        is TileMediaState.Blocked -> OverlayBox(modifier) {
+            Icon(
+                Icons.Default.CloudOff,
+                contentDescription = stringResource(R.string.attachment_media_blocked),
+                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.size(22.dp),
+            )
+        }
+        TileMediaState.Hidden, TileMediaState.Completed -> Unit
+    }
+}
+
+@Composable
+private fun OverlayBox(modifier: Modifier = Modifier, content: @Composable () -> Unit) {
