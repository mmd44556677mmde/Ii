+package com.etozhesandy.redpanda.core.mediadownload.data
+
+import com.etozhesandy.redpanda.core.common.dispatcher.IoDispatcher
+import com.etozhesandy.redpanda.core.mediadownload.domain.repository.MediaDownloadRepository
+import com.etozhesandy.redpanda.core.settings.AppSettings
+import com.etozhesandy.redpanda.core.settings.SettingsRepository
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+
+/**
+ * The rules the user set on the Storage Usage screen, enforced without a screen: per-category
+ * retention ("photos vanish after 2 days of not being opened") and the LRU ceiling. Both read
+ * the same tables the screen does, and both only ever delete **completed** artifacts — a paused
+ * download's bytes are never swept, because they are the resume offset, not cache.
+ *
+ * Runs at process start and after each finished fetch; both triggers are cheap reads over an
+ * indexed table, and neither is scheduled while nothing is happening — the app is offline-first,
+ * not a background service.
+ */
+@Singleton
+class MediaCacheJanitor @Inject constructor(
+    private val repository: MediaDownloadRepository,
+    private val settingsRepository: SettingsRepository,
+    @IoDispatcher ioDispatcher: CoroutineDispatcher,
+) {
+
+    private val scope = CoroutineScope(SupervisorJob() + ioDispatcher)
+
+    /** Kicks the sweep off [MediaCacheJanitor]'s own scope; use where fire-and-forget is wanted. */
+    fun sweepAsync(): Job = scope.launch { sweep() }
+
+    /** Applies every rule once. Errors in one rule must not stop the others. */
+    suspend fun sweep() {
+        val settings = settingsRepository.settings.first()
+        retentionByCategory(settings).forEach { (category, days) ->
+            if (days > 0) runCatching { repository.purgeNotAccessedSinceByCategory(category, days) }
+        }
+        settings.maxMediaCacheSizeBytes
+            .takeIf { it > 0 }
+            ?.let { limit -> runCatching { repository.evictToLimit(limit) } }
+    }
+
+    private fun retentionByCategory(settings: AppSettings): Map<String, Int> = mapOf(
+        "PHOTO" to settings.mediaAutoCleanPhotoDays,
+        "VIDEO" to settings.mediaAutoCleanVideoDays,
+        "AUDIO" to settings.mediaAutoCleanAudioDays,
+        "DOCUMENT" to settings.mediaAutoCleanDocumentDays,
+        "OTHER" to settings.mediaAutoCleanOtherDays,
+    )
+}
