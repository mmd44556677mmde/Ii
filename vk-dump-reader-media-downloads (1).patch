+package com.etozhesandy.redpanda.features.settings.presentation.storage
+
+import com.etozhesandy.redpanda.core.common.mvi.UiEffect
+import com.etozhesandy.redpanda.core.common.mvi.UiEvent
+import com.etozhesandy.redpanda.core.common.mvi.UiState
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.MediaUsage
+
+/** MVI contract of the Storage Usage screen (the Telegram-style cache manager). */
+object StorageUsageState {
+
+    /** One donut segment / one row of the category list. */
+    data class CategoryUsage(
+        val key: String,
+        val bytes: Long,
+        val files: Int,
+        /** True while the row is ticked for the "Clear selected" action. */
+        val isSelected: Boolean = false,
+    )
+
+    /** One row of the per-dialog lists: everything cached for one chat or profile surface. */
+    data class OwnerUsage(
+        val ownerType: String,
+        val ownerId: String,
+        val label: String,
+        val bytes: Long,
+        val files: Int,
+    )
+
+    data class State(
+        val totalBytes: Long = 0L,
+        /** The cache's share of the device's storage, 0..100, shown under the donut. */
+        val deviceSharePercent: Int = 0,
+        val categories: List<CategoryUsage> = emptyList(),
+        /** Per-owner totals per category; the tabs filter it client-side. */
+        val ownerUsage: List<MediaUsage> = emptyList(),
+        /** owner id → display name, joined from dialogs/profiles. */
+        val ownerLabels: Map<String, String> = emptyMap(),
+        val maxCacheSizeBytes: Long = 0L,
+        /** Category key → retention days (0 = never). */
+        val autoCleanDays: Map<String, Int> = emptyMap(),
+        val isClearing: Boolean = false,
+        val isEmpty: Boolean = true,
+    ) : UiState
+
+    sealed interface Event : UiEvent {
+        data object BackClicked : Event
+        data class CategoryToggled(val key: String, val selected: Boolean) : Event
+        data object ClearSelectedClicked : Event
+        data class OwnerPurgeClicked(val ownerType: String, val ownerId: String) : Event
+        data class AutoCleanChanged(val category: String, val days: Int) : Event
+        data class MaxCacheChanged(val bytes: Long) : Event
+    }
+
+    sealed interface Effect : UiEffect {
+        data class Cleared(val bytes: Long) : Effect
+    }
+}
