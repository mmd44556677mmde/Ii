@@ -0,0 +1,101 @@
+package com.etozhesandy.redpanda.media
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import com.etozhesandy.redpanda.core.designsystem.media.RemoteTileController
+import androidx.media3.datasource.DataSource
+import com.etozhesandy.redpanda.core.mediadownload.data.MediaAccessController
+import com.etozhesandy.redpanda.core.model.Attachment
+import com.etozhesandy.redpanda.core.model.AttachmentType
+import com.etozhesandy.redpanda.core.model.TileMediaState
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.flow.flowOf
+import kotlinx.coroutines.launch
+
+/**
+ * The Compose adapter between the designsystem's [RemoteTileController] contract and the
+ * download module's [MediaAccessController]. The designsystem cannot see the download module,
+ * so every call is a thin pass-through and the one piece of state the UI host needs — whether an
+ * Ask-policy confirmation is waiting — is mirrored into a plain boolean flow.
+ */
+@Singleton
+class AppRemoteTileController @Inject constructor(
+    private val controller: MediaAccessController,
+) : RemoteTileController {
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+
+    override val isConfirmationPending: MutableStateFlow<Boolean> = MutableStateFlow(false)
+
+    init {
+        scope.launch {
+            controller.pendingConfirmation.collectLatest { isConfirmationPending.value = it != null }
+        }
+    }
+
+    override fun mediaKeyOf(profileId: String, type: AttachmentType, path: String): String? =
+        controller.mediaKeyOf(profileId, type, path)
+
+    @Composable
+    override fun tileState(mediaKey: String?): TileMediaState {
+        if (mediaKey == null) return TileMediaState.Hidden
+        val state by remember(mediaKey) { controller.observeTileState(mediaKey) }
+            .collectAsState(initial = TileMediaState.Hidden)
+        return state
+    }
+
+    override fun resolvedFile(mediaKey: String?): Flow<String?> =
+        mediaKey?.let(controller::observeResolvedFile) ?: flowOf(null)
+
+    @Composable
+    override fun isRemoteDisplayAllowed(): Boolean {
+        val allowed by remember { controller.observeRemoteDisplayAllowed() }
+            .collectAsState(initial = true)
+        return allowed
+    }
+
+    override fun onTileTap(attachment: Attachment, open: () -> Unit) {
+        controller.onTileTap(attachment, open)
+    }
+
+    override fun onVideoTileTap(attachment: Attachment, open: () -> Unit) {
+        controller.onVideoTileTap(attachment, open)
+    }
+
+    override fun onViewerPageOpen(attachment: Attachment) {
+        controller.onViewerPageOpen(attachment)
+    }
+
+    override fun onVideoPageClosed(mediaKey: String?) {
+        if (mediaKey != null) controller.onVideoPageClosed(mediaKey)
+    }
+
+    override fun pauseDownload(mediaKey: String?) {
+        if (mediaKey != null) controller.pauseDownload(mediaKey)
+    }
+
+    override fun resumeDownload(mediaKey: String?) {
+        if (mediaKey != null) controller.resumeDownload(mediaKey)
+    }
+
+    override fun videoSourceFactory(mediaKey: String?): DataSource.Factory? {
+        return controller.videoSourceFactory(mediaKey)
+    }
+
+    override fun acceptPendingConfirmation() {
+        controller.acceptPendingConfirmation()
+    }
+
+    override fun denyPendingConfirmation() {
+        controller.denyPendingConfirmation()
+    }
+}
