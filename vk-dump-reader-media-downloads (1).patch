+package com.etozhesandy.redpanda.core.mediadownload.domain.model
+
+/**
+ * A request to have one media artifact at full quality on disk.
+ *
+ * Exactly one of [remoteUrl] and [localSourcePath] is set: a remote fetch goes over the network
+ * (only ever a URL that came out of the user's own dump), a local copy streams the file the import
+ * already extracted. The destination is always the manager's own cache directory — never the dump
+ * and never shared storage.
+ */
+data class DownloadRequest(
+    val mediaKey: String,
+    val profileId: String,
+    val dialogId: String?,
+    val attachmentId: String?,
+    val ownerType: MediaOwnerType,
+    val category: MediaCategory,
+    val remoteUrl: String?,
+    val localSourcePath: String?,
+    /** File extension without the dot, taken from the source path/URL; empty when unknowable. */
+    val extension: String,
+) {
+    init {
+        require((remoteUrl == null) != (localSourcePath == null)) {
+            "Exactly one of remoteUrl / localSourcePath must be set"
+        }
+    }
+}
