+import com.etozhesandy.redpanda.core.model.RemoteMediaPolicy
+import com.etozhesandy.redpanda.features.settings.R
+
+/**
+ * The "Load remote media" row: shows the active policy in the list and opens a radio dialog to
+ * change it. The four policies are the whole contract with the download manager, spelled out so
+ * picking one needs no second guess.
+ */
+@Composable
+fun RemoteMediaPolicyItem(
+    selected: RemoteMediaPolicy,
+    onSelect: (RemoteMediaPolicy) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    var dialogShown by remember { mutableStateOf(false) }
+
+    ListItem(
+        modifier = modifier.clickable { dialogShown = true },
+        headlineContent = { Text(stringResource(R.string.settings_remote_media)) },
+        supportingContent = { Text(stringResource(selected.summaryRes)) },
+    )
+
+    if (dialogShown) {
+        AlertDialog(
+            onDismissRequest = { dialogShown = false },
+            title = { Text(stringResource(R.string.settings_remote_media)) },
+            text = {
+                Column {
+                    RemoteMediaPolicy.entries.forEach { policy ->
+                        ListItem(
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .clickable {
+                                    onSelect(policy)
+                                    dialogShown = false
+                                },
+                            headlineContent = { Text(stringResource(policy.optionRes)) },
+                            leadingContent = {
+                                RadioButton(selected = policy == selected, onClick = null)
+                            },
+                        )
+                    }
+                }
+            },
+            confirmButton = {
+                TextButton(onClick = { dialogShown = false }) {
+                    Text(stringResource(R.string.settings_remote_media_close))
+                }
+            },
+        )
+    }
+}
+
+/** The one-line summary under the row title, per policy. */
+private val RemoteMediaPolicy.summaryRes: Int
+    get() = when (this) {
+        RemoteMediaPolicy.ALWAYS -> R.string.settings_remote_media_always_summary
+        RemoteMediaPolicy.WIFI_ONLY -> R.string.settings_remote_media_wifi_summary
+        RemoteMediaPolicy.ASK -> R.string.settings_remote_media_ask_summary
+        RemoteMediaPolicy.NEVER -> R.string.settings_remote_media_never_summary
+    }
+
+/** The dialog's option line, per policy. */
+private val RemoteMediaPolicy.optionRes: Int
+    get() = when (this) {
+        RemoteMediaPolicy.ALWAYS -> R.string.settings_remote_media_always
+        RemoteMediaPolicy.WIFI_ONLY -> R.string.settings_remote_media_wifi
+        RemoteMediaPolicy.ASK -> R.string.settings_remote_media_ask
+        RemoteMediaPolicy.NEVER -> R.string.settings_remote_media_never
+    }
