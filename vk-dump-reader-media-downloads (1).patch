+@Composable
+private fun RemoteAwareImagePage(
+    attachment: Attachment,
+    isCurrentPage: Boolean,
+    zoom: ZoomState?,
+    modifier: Modifier = Modifier,
+) {
+    val controller = LocalRemoteTileController.current
+    val mediaKey = controller.mediaKeyOf(attachment.profileId, attachment.type, attachment.path)
+    val isRemote = attachment.path.startsWith("http")
+
+    if (!isRemote) {
+        MediaImage(
+            model = File(attachment.path),
+            zoom = zoom,
+            modifier = modifier,
+            error = { AttachmentPlaceholder(attachment.type, attachment.caption) },
+        )
+        return
+    }
+
+    // Off-screen neighbours must not start fetches; only the page the user is actually on may.
+    LaunchedEffect(isCurrentPage, mediaKey) {
+        if (isCurrentPage) controller.onViewerPageOpen(attachment)
+    }
+
+    val tileState = controller.tileState(mediaKey)
+    val resolvedFile by remember(mediaKey) { controller.resolvedFile(mediaKey) }
+        .collectAsState(initial = null)
+    val resolvedModel = resolvedFile?.let(::File) ?: attachment.path
+
+    Box(modifier = modifier, contentAlignment = Alignment.Center) {
+        MediaImage(
+            model = resolvedModel,
+            zoom = zoom,
+            error = { AttachmentPlaceholder(attachment.type, attachment.caption) },
+        )
+        when (tileState) {
+            TileMediaState.Queued, TileMediaState.Paused ->
+                DownloadProgressRing(fraction = null, modifier = Modifier.size(48.dp))
+            is TileMediaState.Downloading ->
+                DownloadProgressRing(fraction = tileState.fraction, modifier = Modifier.size(48.dp))
+            is TileMediaState.Blocked ->
+                AttachmentPlaceholder(attachment.type, attachment.caption)
+            TileMediaState.Hidden, TileMediaState.Completed -> Unit
+        }
+    }
+}
