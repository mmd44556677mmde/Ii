@@ -0,0 +1,86 @@
+package com.etozhesandy.redpanda.core.mediadownload.domain.repository
+
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.CachedMedia
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.DownloadRequest
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.MediaDownloadState
+import com.etozhesandy.redpanda.core.mediadownload.domain.model.MediaUsage
+import java.io.File
+import kotlinx.coroutines.flow.Flow
+
+/**
+ * The one door every screen knocks on for full-quality media. Thumbnails never come through here —
+ * they stay on Coil and its own cache; this contract is only for the explicit, user-initiated
+ * fetches: the photo's first tap, the video player, an audio or document the viewer asks for.
+ *
+ * Everything is user-initiated and screen-scoped: nothing here runs while no screen holds an
+ * interest, and the only writes are into the reader's own cache directory.
+ */
+interface MediaDownloadRepository {
+
+    /** Cold-start recovery: rows stuck mid-transfer from a previous process become Paused. */
+    suspend fun recoverInterruptedDownloads()
+
+    /** One state per media key; the flow replays the current state to each new collector. */
+    fun observeState(mediaKey: String): Flow<MediaDownloadState>
+
+    suspend fun currentState(mediaKey: String): MediaDownloadState
+
+    /**
+     * Registers the request and starts it (or resumes a paused one). Idempotent: calling it again
+     * while Running/Queued is a no-op, and on a Completed row it is a cache hit that touches the
+     * LRU clock and returns the file.
+     */
+    suspend fun request(request: DownloadRequest): MediaDownloadState
+
+    /** Stops the transfer at the current offset, keeping every byte written so far. */
+    suspend fun pause(mediaKey: String)
+
+    /** Continues from the persisted offset. Validators are re-checked against the source. */
+    suspend fun resume(mediaKey: String)
+
+    /** Stops and forgets: deletes the partial and the row, so the next tap starts from zero. */
+    suspend fun cancel(mediaKey: String)
+
+    /** The completed file, or null. A non-null answer touches [MediaDownloadState.Completed] for LRU. */
+    suspend fun cachedFile(mediaKey: String): File?
+
+    /**
+     * The file as it exists right now — partial included — so a player can start reading bytes
+     * the chunk engine has already written while the rest is still on its way. Null when no row
+     * exists or nothing was written yet.
+     */
+    suspend fun partialFile(mediaKey: String): File?
+
+    /** Synchronous variant for viewers that need the file or nothing, without starting a fetch. */
+    suspend fun peekCached(mediaKey: String): CachedMedia?
+
+    // --- Storage Usage ----------------------------------------------------------------------
+
+    fun observeUsageByCategory(): Flow<List<MediaUsage>>
+
+    /** Per dialog / profile / saved-photos / archive-folder rows, grouped for the storage tabs. */
+    fun observeUsageByOwner(): Flow<List<MediaUsage>>
+
+    /** Same grouping as [observeUsageByOwner] but one row per owner, with its display name. */
+    fun observeUsageByOwnerNamed(): Flow<List<MediaUsage>>
+
+    fun observeTotalCachedBytes(): Flow<Long>
+
+    /** Deletes the completed files of the checked categories; returns bytes freed. */
+    suspend fun purgeCategories(categories: Set<String>): Long
+
+    /** Deletes the completed files of one dialog / profile; returns bytes freed. */
+    suspend fun purgeOwner(ownerType: String, ownerId: String): Long
+
+    /** Deletes completed files not touched for [retentionDays]; returns bytes freed. */
+    suspend fun purgeNotAccessedSinceDays(retentionDays: Int): Long
+
+    /** The same sweep narrowed to one category ("PHOTO", "VIDEO", ...); returns bytes freed. */
+    suspend fun purgeNotAccessedSinceByCategory(category: String, retentionDays: Int): Long
+
+    /** LRU eviction down to [limitBytes]; returns bytes freed, 0 when already under the limit. */
+    suspend fun evictToLimit(limitBytes: Long): Long
+
+    /** Directory the completed files live in, for the byte counts the file system is asked for. */
+    fun cacheDirectory(): File
+}
