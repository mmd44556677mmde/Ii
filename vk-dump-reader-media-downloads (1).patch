+package com.etozhesandy.redpanda.core.mediadownload.data.downloader
+
+import java.io.File
+
+/** Builds the destination file the manager writes full-quality media into. */
+object MediaFiles {
+
+    /** Below `cacheDir`, alongside Coil's own `image_cache` — the reader's private storage only. */
+    const val CACHE_DIR_NAME = "media"
+
+    /**
+     * The extension comes from the source, so ExoPlayer and Coil get a type hint; the hash alone
+     * would leave both guessing.
+     */
+    fun destination(cacheDir: File, mediaKey: String, extension: String): File =
+        cacheDir.resolve(
+            if (extension.isBlank()) mediaKey else "$mediaKey.${extension.take(8).lowercase()}",
+        )
+}
