+package com.etozhesandy.redpanda.core.model
+
+/**
+ * What a media tile or a viewer page should overlay on top of the media itself, driven by the
+ * media download manager. Deliberately coarser than `MediaDownloadState`: the UI never needs the
+ * byte counts, only the ring, and one shared type lets the designsystem render the overlay without
+ * depending on the download module.
+ */
+sealed interface TileMediaState {
+
+    /** Nothing to overlay: local media, or a remote artifact that is neither running nor blocked. */
+    data object Hidden : TileMediaState
+
+    /** Full-quality fetch enqueued, progress not measurable yet. */
+    data object Queued : TileMediaState
+
+    /** Full-quality fetch in flight. [fraction] is 0f..1f, or null while the size is unknown. */
+    data class Downloading(val fraction: Float?) : TileMediaState
+
+    /** Stopped with bytes kept — a resume continues from the offset, it does not restart. */
+    data object Paused : TileMediaState
+
+    /**
+     * The fetch never started because the "Load remote media" policy said no: the network is
+     * metered under Wi-Fi-only, or the setting is Never. The tile says why instead of spinning.
+     */
+    data class Blocked(val reason: TileBlockReason) : TileMediaState
+
+    /** The full-quality copy is on disk; the viewer opens it directly. */
+    data object Completed : TileMediaState
+}
+
+/** Why a remote fetch is not happening, for the tile's supporting text and for analytics-free logs. */
+enum class TileBlockReason {
+    /** The setting is Never: nothing remote is ever fetched. */
+    NEVER,
+
+    /** Wi-Fi-only is active and the active network is metered. */
+    METERED,
+}
