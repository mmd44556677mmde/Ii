+package com.etozhesandy.redpanda.core.mediadownload.domain.model
+
+import com.etozhesandy.redpanda.core.model.AttachmentType
+
+/**
+ * The coarse bucket a cached artifact is reported under on the Storage Usage screen. Coarser than
+ * [AttachmentType] on purpose: the donut has five segments, not ten, and stickers/graffiti are
+ * photos to the user.
+ */
+enum class MediaCategory {
+    PHOTO,
+    VIDEO,
+    AUDIO,
+    DOCUMENT,
+    OTHER,
+    ;
+
+    companion object {
+        fun from(type: AttachmentType): MediaCategory = when (type) {
+            AttachmentType.PHOTO, AttachmentType.STICKER, AttachmentType.GRAFFITI -> PHOTO
+            AttachmentType.VIDEO -> VIDEO
+            AttachmentType.AUDIO -> AUDIO
+            AttachmentType.FILE -> DOCUMENT
+            AttachmentType.LINK, AttachmentType.WALL, AttachmentType.CALL, AttachmentType.OTHER -> OTHER
+        }
+    }
+}
